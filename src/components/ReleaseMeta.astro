---
import type { Release } from '../lib/apps';
import { fmtDate, t, ui, type Lang } from '../lib/i18n';
interface Props { release: Release; lang: Lang }
const { release: r, lang } = Astro.props;
---
<p class="rmeta">
  {r.build && <>{ui[lang].build} {r.build} · </>}
  <time datetime={r.date.toISOString().slice(0, 10)}>{fmtDate(r.date, lang)}</time> · {t(r.requirement, lang)}
</p>
<style>
  .rmeta { color: var(--text-3); font-size: 14px; }
</style>
