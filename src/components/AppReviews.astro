---
import type { Lang } from '../lib/i18n';
interface Props { appId: string; lang: Lang }
const { appId, lang } = Astro.props;
const zh = lang === 'zh';
---
<section id="reviews" class="reviews" data-app-reviews data-app={appId} data-lang={lang}>
  <div class="wrap">
    <div class="sec-head"><div><p class="eyebrow">Community</p><h2>{zh ? '喜欢它？聊聊你的体验' : 'How has your experience been?'}</h2><p class="muted">{zh ? '无需登录，分享真实使用感受。' : 'No sign-in needed. Share your experience.'}</p></div></div>
    <div class="review-grid">
      <div class="card review-score">
        <p class="muted">{zh ? '用户评分' : 'Community rating'}</p>
        <p class="score"><strong data-average>—</strong><span>/ 5</span></p>
        <p class="muted small" data-rating-count>{zh ? '正在加载…' : 'Loading…'}</p>
        <button class="btn btn-s" type="button" data-like aria-pressed="false" disabled>♡ <span data-like-text>{zh ? '点赞' : 'Like'}</span> <span data-likes>—</span></button>
        <fieldset data-vote-controls disabled><legend>{zh ? '你的评分' : 'Your rating'}</legend><div class="stars">
          {[1,2,3,4,5].map(n => <label><input type="radio" name={`rating-${appId}`} value={n} aria-label={zh ? `${n} 星` : `${n} ${n === 1 ? 'star' : 'stars'}`} /><span aria-hidden="true">★</span></label>)}
        </div><button class="clear-rating" type="button" data-clear hidden>{zh ? '撤回评分' : 'Remove rating'}</button></fieldset>
        <p class="muted small">{zh ? '同一浏览器保留一份点赞和评分，随时可修改。' : 'One like and rating per browser. You can change them anytime.'}</p>
      </div>
      <div class="review-discussion">
        <div data-composer-home></div>
        <form class="card review-form" data-comment-form>
          <label for={`comment-${appId}`}>{zh ? '匿名评论' : 'Anonymous comment'}</label>
          <div class="reply-target" data-reply-target hidden><span data-reply-label></span><button type="button" class="clear-rating" data-cancel-reply>{zh ? '取消回复' : 'Cancel reply'}</button></div>
          <textarea id={`comment-${appId}`} name="body" rows="4" maxlength="1000" required placeholder={zh ? '哪些地方好用？你希望改进什么？' : 'What works well? What could be better?'}></textarea>
          <p class="muted small">{zh ? '评论和回复提交后直接公开，未登录时以访客编号区分。请勿填写联系方式、密码等隐私信息。最多 1000 字。' : 'Comments and replies appear immediately. Signed-out visitors use a guest ID. Do not include contact details, passwords or other private information. Up to 1,000 characters.'}</p>
          <p class="muted small">{zh ? '登录后显示账号昵称，管理员带“站长”标识。回复提醒可跨浏览器查看；匿名评论请在原浏览器查看。' : 'Signed-in comments show your name, with a badge for the site owner. Reply notifications follow your account; anonymous comments stay in their original browser.'}</p>
          <p class="review-status" role="status" aria-live="polite" data-review-status></p>
          <button class="btn btn-p btn-sm" type="submit" disabled>{zh ? '提交评论' : 'Submit comment'}</button>
        </form>
        <button type="button" class="btn btn-s btn-sm" data-retry hidden>{zh ? '重新加载' : 'Retry'}</button>
        <div class="comments-heading"><h3>{zh ? '大家的评论' : 'Community comments'}</h3><span class="muted small">{zh ? '最新评论在前 · 回复按话题归组' : 'Newest first · Replies grouped by topic'}</span></div>
        <a class="btn btn-s btn-sm" data-all-comments href={lang === 'zh' ? `/apps/${appId}/#reviews` : `/en/apps/${appId}/#reviews`} hidden>{zh ? '查看全部评论' : 'View all comments'}</a>
        <p class="muted" data-empty hidden>{zh ? '还没有公开评论，欢迎分享第一条体验。' : 'No published comments yet. Be the first to share your experience.'}</p>
        <div data-comments></div>
        <button type="button" class="btn btn-s btn-sm" data-more hidden>{zh ? '加载更多' : 'Load more'}</button>
      </div>
    </div>
    <noscript>{zh ? '请启用 JavaScript 查看评分和评论。' : 'Enable JavaScript to view ratings and comments.'}</noscript>
  </div>
</section>
<script>
  import { getMe, onSignedOut, markSignedOut } from '../lib/auth-client';
  import { markRepliesRead } from '../lib/reply-notifications';
  for (const root of document.querySelectorAll<HTMLElement>('[data-app-reviews]')) {
    const zh = root.dataset.lang === 'zh';
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const status = $('[data-review-status]');
    const like = $<HTMLButtonElement>('[data-like]');
    const fieldset = $<HTMLFieldSetElement>('[data-vote-controls]');
    const form = $<HTMLFormElement>('[data-comment-form]');
    const submit = form.querySelector<HTMLButtonElement>('[type=submit]')!;
    const textarea = form.querySelector('textarea')!;
    const more = $<HTMLButtonElement>('[data-more]');
    const retry = $<HTMLButtonElement>('[data-retry]');
    const clear = $<HTMLButtonElement>('[data-clear]');
    const endpoint = `/api/community/${encodeURIComponent(root.dataset.app!)}`;
    let focusId = new URLSearchParams(location.search).get('focus');
    $('[data-all-comments]').hidden = !focusId;
    let liked = false, rating: number | null = null, next: string | null = null, busy = false, ready = false;
    let requestId = '', submittedBody = '';
    type Entry = { id: string; body: string; author: string; replyTo: string | null; createdAt: number; threadId: string | null; replies?: Entry[]; repliesNext?: string | null; authorRole: 'owner' | 'member' | 'guest'; likeCount: number; likedByMe: boolean };
    let signedIn = false;
    const identityLabel = form.querySelector('label')!;
    void getMe().then(me => { signedIn = Boolean(me); if (me) identityLabel.textContent = me.isAdmin ? (zh ? '站长评论' : 'Site owner comment') : (zh ? `${me.name}的评论` : `Comment as ${me.name}`); });
    onSignedOut(() => { signedIn = false; identityLabel.textContent = zh ? '匿名评论' : 'Anonymous comment'; });
    let target: Entry | null = null;
    const threads = new Map<string, { list: HTMLElement; more: HTMLButtonElement; next: string | null }>();
    function cancelReply() {
      target = null; requestId = ''; $('[data-reply-target]').hidden = true;
      $('[data-composer-home]').after(form); form.classList.remove('is-replying');
      submit.textContent = zh ? '提交评论' : 'Submit comment';
    }
    $('[data-cancel-reply]').addEventListener('click', () => { if (!busy) { cancelReply(); textarea.focus(); } });
    function guest(name: string) { return zh ? name : name.replace('访客 ', 'Guest '); }
    function renderComment(c: Entry, nested = false) {
      const item = document.createElement('article'); item.className = nested ? 'thread-reply' : 'public-comment';
      item.id = `comment-${c.id}`;
      if (c.id === focusId) item.classList.add('focused-comment');
      const head = document.createElement('header'); head.className = 'comment-meta';
      const avatar = document.createElement('span'); avatar.className = 'comment-avatar'; avatar.setAttribute('aria-hidden', 'true');
      avatar.textContent = c.authorRole === 'owner' ? 'A' : [...guest(c.author)][0] ?? '?';
      const author = document.createElement('strong'); author.className = 'comment-author'; author.textContent = guest(c.author);
      head.append(avatar, author);
      if (c.authorRole === 'owner') { const badge = document.createElement('span'); badge.className = 'author-owner'; badge.textContent = zh ? '站长' : 'Site owner'; head.append(badge); }
      const time = document.createElement('time'); time.dateTime = new Date(c.createdAt).toISOString();
      time.textContent = new Date(c.createdAt).toLocaleString(zh ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
      head.append(time);
      const body = document.createElement('p'); body.className = 'comment-body'; body.textContent = c.body;
      const recipient = document.createElement('p'); recipient.className = 'comment-recipient'; recipient.hidden = !c.replyTo;
      recipient.textContent = c.replyTo ? `${zh ? '回复' : 'Reply to'} ${guest(c.replyTo)}` : '';
      const button = document.createElement('button'); button.type = 'button'; button.className = 'comment-reply-button'; button.textContent = zh ? '回复' : 'Reply';
      button.addEventListener('click', () => {
        if (busy) return;
        target = c; requestId = ''; $('[data-reply-target]').hidden = false;
        $('[data-reply-label]').textContent = `${zh ? '回复' : 'Reply to'} ${guest(c.author)}: ${c.body.slice(0, 80)}`;
        submit.textContent = zh ? '提交回复' : 'Post reply'; actions.after(form); form.classList.add('is-replying'); form.scrollIntoView({ behavior: 'smooth', block: 'center' }); textarea.focus({ preventScroll: true });
      });
      const actions = document.createElement('div'); actions.className = 'comment-actions';
      const likeButton = document.createElement('button'); likeButton.type = 'button'; likeButton.className = 'comment-like-button';
      likeButton.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 10v10H3V10h4Zm0 0 5-7c1-1 2 0 2 1v5h5a2 2 0 0 1 2 2l-2 8a2 2 0 0 1-2 1H7"/></svg>';
      const likeText = document.createElement('span'); likeButton.append(likeText);
      const paintLike = () => { likeText.textContent = `${zh ? (c.likedByMe ? '已赞' : '赞') : (c.likedByMe ? 'Liked' : 'Like')} ${c.likeCount}`; likeButton.setAttribute('aria-pressed', String(c.likedByMe)); likeButton.setAttribute('aria-label', zh ? `${c.likedByMe ? '取消点赞' : '点赞'}，${c.likeCount} 赞` : `${c.likedByMe ? 'Unlike' : 'Like'}, ${c.likeCount} likes`); };
      paintLike();
      likeButton.addEventListener('click', async () => {
        if (busy || likeButton.disabled) return;
        likeButton.disabled = true;
        try {
          const result = await response(await fetch(endpoint, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'comment-like', commentId: c.id, liked: !c.likedByMe }) }));
          c.likeCount = result.likeCount; c.likedByMe = result.likedByMe; paintLike();
        } catch (e) { status.textContent = (e as Error).message; }
        finally { likeButton.disabled = false; }
      });
      actions.append(likeButton, button); item.append(head, recipient, body, actions);
      if (!nested) {
        const list = document.createElement('div'); list.className = 'thread-replies';
        const heading = document.createElement('summary'); heading.className = 'thread-heading'; heading.textContent = zh ? '回复讨论 · 最新在前' : 'Replies · Newest first';
        const discussion = document.createElement('details'); discussion.open = true; discussion.className = 'thread-discussion'; discussion.hidden = !(c.replies?.length || c.repliesNext);
        discussion.append(heading, list);
        const more = document.createElement('button'); more.type = 'button'; more.className = 'btn btn-s btn-sm'; more.textContent = zh ? '更多回复' : 'More replies'; more.hidden = !c.repliesNext;
        for (const reply of c.replies ?? []) list.append(renderComment(reply, true));
        threads.set(c.id, { list, more, next: c.repliesNext ?? null });
        more.addEventListener('click', () => { void loadThread(c.id, true); });
        discussion.append(more); item.append(discussion);
      }
      return item;
    }
    async function loadThread(id: string, append = false) {
      const thread = threads.get(id); if (!thread || thread.more.disabled || busy) return;
      busy = true; controls(); thread.more.disabled = true;
      try {
        const query = new URLSearchParams({ thread: id }); if (append && thread.next) query.set('cursor', thread.next);
        const d = await response(await fetch(`${endpoint}?${query}`, { credentials: 'same-origin', cache: 'no-store' }));
        if (!append) thread.list.replaceChildren();
        const discussion = thread.list.parentElement as HTMLDetailsElement;
        discussion.hidden = false; if (!append) discussion.open = true;
        for (const c of d.comments) if (!thread.list.querySelector(`#comment-${CSS.escape(c.id)}`)) thread.list.append(renderComment(c, true));
        thread.next = d.next; thread.more.hidden = !d.next;
      } catch (e) { status.textContent = (e as Error).message; }
      finally { thread.more.disabled = false; busy = false; controls(); }
    }
    const message = (cn: string, en: string) => { status.textContent = zh ? cn : en; };
    const controls = () => { textarea.readOnly = busy; like.disabled = fieldset.disabled = submit.disabled = busy || !ready; more.disabled = retry.disabled = busy; };
    function paintVote() {
      like.setAttribute('aria-pressed', String(liked));
      $('[data-like-text]').textContent = liked ? (zh ? '已点赞' : 'Liked') : (zh ? '点赞' : 'Like');
      for (const input of root.querySelectorAll<HTMLInputElement>('.stars input')) { input.checked = Number(input.value) === rating; input.parentElement!.classList.toggle('filled', Number(input.value) <= (rating ?? 0)); }
      clear.hidden = rating === null;
    }
    function paintSummary(s: { average: number | null; ratings: number; likes: number }) {
      $('[data-average]').textContent = s.average === null ? '—' : s.average.toFixed(1);
      $('[data-rating-count]').textContent = s.ratings ? (zh ? `${s.ratings} 份评分` : `${s.ratings} ${s.ratings === 1 ? 'rating' : 'ratings'}`) : (zh ? '暂无评分' : 'No ratings yet');
      $('[data-likes]').textContent = String(s.likes);
    }
    async function response(r: Response) {
      if (r.status === 401) markSignedOut();
      if (!r.ok) throw new Error(r.status === 401 ? (zh ? '登录已失效，请重新登录后再回复。' : 'Your session expired. Please sign in again.') : r.status === 429 ? (zh ? '提交较频繁，请稍后再试。' : 'Too many submissions. Please try again later.') : r.status === 428 ? (zh ? '请允许本站 Cookie 后重新加载。' : 'Please allow site cookies and reload.') : (zh ? '暂时无法完成，请重试。' : 'Unable to complete. Please try again.'));
      return r.json();
    }
    async function load(append = false) {
      if (busy) return;
      busy = true; controls(); retry.hidden = true;
      try {
        const d = await response(await fetch(endpoint + (append && next ? `?cursor=${encodeURIComponent(next)}` : focusId ? `?focus=${encodeURIComponent(focusId)}` : ''), { credentials: 'same-origin', cache: 'no-store' }));
        paintSummary(d.summary); liked = d.mine.liked; rating = d.mine.rating; paintVote();
        const list = $('[data-comments]');
        if (!append) { if (target) cancelReply(); list.replaceChildren(); threads.clear(); }
        for (const c of d.comments) list.append(renderComment(c));
        $('[data-empty]').hidden = list.childElementCount > 0;
        next = d.next; more.hidden = !next; ready = true;
        $('[data-all-comments]').hidden = !focusId;
        if (focusId && !append) {
          const focused = document.getElementById(`comment-${focusId}`);
          if (focused) {
            focused.scrollIntoView({ behavior: 'smooth', block: 'start' });
            const id = focusId;
            const mark = () => { void markRepliesRead([id]).catch(() => { /* Retain unread state on network errors. */ }); };
            if ('IntersectionObserver' in window) {
              const seen = new IntersectionObserver(entries => {
                if (document.visibilityState !== 'visible' || !entries.some(e => e.isIntersecting)) return;
                seen.disconnect(); mark();
              });
              seen.observe(focused);
            } else if (document.visibilityState === 'visible') mark();
          }
        }
        status.textContent = '';
      } catch (e) { status.textContent = (e as Error).message; retry.hidden = false; if (!ready) $('[data-rating-count]').textContent = zh ? '评分暂不可用' : 'Ratings unavailable'; }
      finally { busy = false; controls(); }
    }
    async function write(value: Record<string, unknown>) {
      if (busy) return;
      busy = true; controls(); message('正在保存…', 'Saving…');
      let refresh: string | null | undefined;
      let publishedId: string | undefined;
      try {
        const d = await response(await fetch(endpoint, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(value) }));
        if (value.action === 'comment') {
          publishedId = d.id; refresh = target ? (target.threadId ?? target.id) : null; textarea.value = ''; cancelReply();
          if (refresh === null && focusId) { focusId = null; const url = new URL(location.href); url.searchParams.delete('focus'); history.replaceState(null, '', url); }
          document.dispatchEvent(new Event('an:comment-posted'));
          message('已发布，谢谢你的分享。', 'Published. Thanks for sharing.');
        }
        else { if (value.action === 'like') liked = value.liked as boolean; else rating = value.rating as number | null; paintSummary(d.summary); message('已保存，谢谢你的反馈。', 'Saved. Thanks for your feedback.'); }
      } catch (e) { status.textContent = (e as Error).message; }
      finally { paintVote(); busy = false; controls(); }
      if (refresh === null) await load(); else if (refresh) await loadThread(refresh);
      if (publishedId) {
        const published = document.getElementById(`comment-${publishedId}`);
        if (published) { published.tabIndex = -1; published.focus({ preventScroll: true }); published.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
      }
    }
    like.addEventListener('click', () => { void write({ action: 'like', liked: !liked }); });
    fieldset.addEventListener('change', e => { void write({ action: 'rate', rating: Number((e.target as HTMLInputElement).value) }); });
    clear.addEventListener('click', () => { void write({ action: 'rate', rating: null }); });
    form.addEventListener('submit', e => {
      e.preventDefault(); const body = textarea.value.trim(); if (!body) { textarea.focus(); return; }
      if (!requestId || submittedBody !== body) { requestId = crypto.randomUUID(); submittedBody = body; }
      void write({ action: 'comment', body, requestId, parentId: target?.id ?? null, requireLogin: signedIn });
    });
    more.addEventListener('click', () => { void load(true); });
    retry.addEventListener('click', () => { void load(); });
    // Reviews are usually far below the fold; don't compete with the initial document and images.
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        observer.disconnect(); void load();
      }, { rootMargin: '300px' });
      observer.observe(root);
    } else { void load(); }
  }
</script>
<style>
  .reviews { border-top: 1px solid var(--line); scroll-margin-top: 120px; }
  .review-grid { display: grid; grid-template-columns: minmax(220px, .42fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .review-score { display: grid; gap: 16px; }
  .score { display: flex; gap: 10px; align-items: baseline; }.score strong { font-size: 56px; line-height: 1; }.score span { color: var(--text-3); }
  .review-score .btn { width: fit-content; gap: 9px; }.btn[aria-pressed=true] { color: var(--accent); border-color: var(--accent); }
  fieldset { border: 0; padding: 0; margin: 4px 0; }legend { font-size: 14px; margin-bottom: 8px; }
  .stars { display: flex; gap: 6px; }.stars label { position: relative; cursor: pointer; }.stars input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }.stars span { display: block; padding: 0 3px; font-size: 32px; color: var(--text-3); }.stars .filled span { color: var(--accent); }.stars input:focus-visible + span { outline: 2px solid var(--accent); border-radius: 5px; }.clear-rating { font-size: 12px; color: var(--text-2); margin-top: 8px; background: none; border: 0; text-decoration: underline; cursor: pointer; }
  .review-form { display: grid; gap: 14px; }.review-form label { font-weight: 600; }.review-form textarea { width: 100%; min-height: 120px; padding: 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg); color: var(--text); font: inherit; resize: vertical; }.review-form .btn { justify-self: start; }.review-status { margin: 16px 0; font-size: 14px; }.comments-heading { font-size: 20px; margin: 28px 0 16px; }
  .review-discussion { min-width: 0; }
  .small { font-size: 13px; line-height: 1.65; }
  .comments-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; }
  .comments-heading h3 { font-size: 20px; }
  .review-status:empty { display: none; }
  [data-comments] { display: grid; gap: 20px; margin-top: 16px; }
  [data-comments] :global(.public-comment) { padding: 24px; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); overflow-wrap: anywhere; min-width: 0; }
  [data-comments] :global(.comment-meta) { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 13px; }
  [data-comments] :global(.comment-avatar) { display: grid; place-items: center; width: 32px; height: 32px; flex: none; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  [data-comments] :global(.comment-author) { color: var(--text); }
  [data-comments] :global(time) { color: var(--text-2); font-size: 12px; margin-left: auto; }
  [data-comments] :global(.comment-body) { margin: 12px 0 8px; white-space: pre-wrap; font-size: 15px; line-height: 1.8; }
  [data-comments] :global(.comment-recipient) { margin-top: 12px; padding: 6px 10px; border-left: 2px solid var(--accent); background: var(--accent-soft); color: var(--text-2); font-size: 12px; border-radius: 0 6px 6px 0; }
  [data-comments] :global(.thread-discussion) { margin-top: 18px; margin-left: 12px; padding: 16px 18px; border-left: 2px solid var(--accent); border-radius: 0 12px 12px 0; background: var(--surface-2); }
  [data-comments] :global(.thread-heading) { color: var(--text-2); font-size: 12px; font-weight: 600; cursor: pointer; padding: 4px 0; }
  [data-comments] :global(.thread-reply) { padding: 18px 0; border-bottom: 1px solid var(--line); }
  [data-comments] :global(.thread-reply:last-child) { border-bottom: 0; padding-bottom: 4px; }
  [data-comments] :global(.thread-reply .comment-avatar) { width: 26px; height: 26px; font-size: 12px; }
  [data-comments] :global(.comment-actions) { display: flex; align-items: center; gap: 16px; }
  [data-comments] :global(.comment-reply-button), [data-comments] :global(.comment-like-button) { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; border: 0; border-radius: 8px; background: none; padding: 6px 8px; font: inherit; font-size: 13px; color: var(--text-2); cursor: pointer; font-variant-numeric: tabular-nums; }
  [data-comments] :global(.comment-actions button:hover) { background: var(--accent-soft); color: var(--accent); }
  [data-comments] :global(.comment-like-button[aria-pressed=true]), [data-comments] :global(.comment-reply-button) { color: var(--accent); }
  [data-comments] :global(.author-owner) { padding: 2px 7px; border-radius: 5px; background: var(--accent-soft); color: var(--accent); font-size: 11px; font-weight: 600; }
  [data-comments] :global(.focused-comment) { outline: 2px solid var(--accent); outline-offset: 4px; scroll-margin-top: 132px; }
  .reply-target { display: flex; align-items: start; gap: 12px; justify-content: space-between; font-size: 13px; overflow-wrap: anywhere; padding: 12px; background: var(--accent-soft); border-radius: 10px; }
  .reply-target .clear-rating { flex-shrink: 0; margin: 0; min-height: 28px; }
  .review-form.is-replying { margin-top: 12px; padding: 16px; box-shadow: none; border-color: var(--accent); }
  [data-more] { margin-top: 20px; }
  button:disabled { opacity: .5; cursor: wait; }
  @media(max-width: 700px) {
    .review-grid { grid-template-columns: 1fr; }
    .review-score { gap: 12px; }
    [data-comments] :global(.public-comment) { padding: 16px; }
    [data-comments] :global(.thread-discussion) { margin-left: 0; padding: 12px; }
    [data-comments] :global(time) { flex-basis: 100%; margin-left: 0; }
    .review-form.is-replying { padding: 12px; }
