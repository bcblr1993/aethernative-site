---
import type { App } from '../lib/apps';
import { ui, type Lang } from '../lib/i18n';

interface Props {
  app: App;
  lang: Lang;
  tech?: boolean;
  maxTech?: number;
}

const { app, lang, tech = true, maxTech = 2 } = Astro.props;
const u = ui[lang];
const techTags = tech ? app.data.tech.slice(0, maxTech) : [];
---
<div class="badges">
  {app.data.platforms.filter((p) => p.id === 'mac').map((p) => {
    const status = u.status[p.status];
    const baseLabel = lang === 'zh' ? 'M 芯片 · macOS 26+' : 'M-series · macOS 26+';
    return (
      <span class:list={['badge', { soon: p.status === 'coming' || p.status === 'dev' }]}>
        {baseLabel}{status && ` ${status}`}
      </span>
    );
  })}
  {techTags.map((x) => <span class="badge gray">{x}</span>)}
</div>
