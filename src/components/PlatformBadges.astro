---
import type { App } from '../lib/apps';
import { ui, type Lang } from '../lib/i18n';
interface Props { app: App; lang: Lang; tech?: boolean }
const { app, lang, tech = true } = Astro.props;
const u = ui[lang];
---
<div class="badges">
  {app.data.platforms.map((p) => {
    const status = u.status[p.status];
    return (
      <span class:list={['badge', { soon: p.status === 'coming' || p.status === 'dev' }]}>
        {u.platform[p.id]}{status && ` ${status}`}
      </span>
    );
  })}
  {tech && app.data.tech.map((x) => <span class="badge gray">{x}</span>)}
</div>
