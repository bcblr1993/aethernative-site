---
// 导航栏的登录入口 / 账号菜单。
// 静态输出“登录”按钮；只有浏览器带着 an_signed_in 标记时才请求 /api/me，未登录访客不产生任何接口请求。
// 不开 JS 也能登录（链接直接跳转到授权页）。
import { href, ui, type Lang } from '../lib/i18n';
import LoginButtons from './LoginButtons.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = ui[lang].auth;
---
<div class="auth" data-auth data-lang={lang}>
  <details class="pop" data-auth-out>
    <summary class="icon-btn">{u.signIn}</summary>
    <div class="panel" role="dialog" aria-label={u.title}>
      <strong class="title">{u.title}</strong>
      <p class="lead-s">{u.lead}</p>
      <LoginButtons lang={lang} />
      <p class="fine">{u.agree} <a href={href(lang, '/privacy/')}>{u.privacyLink}</a>{lang === 'zh' ? '。' : '.'}</p>
    </div>
  </details>

  <details class="pop" data-auth-in hidden>
    <summary class="avatar" aria-label={u.account}><img alt="" referrerpolicy="no-referrer" data-avatar hidden /><span data-initial></span></summary>
    <div class="panel">
      <strong class="title" data-name></strong>
      <span class="fine" data-email></span>
      <span class="fine" data-via></span>
      <hr />
      <a class="item" href={href(lang, '/feedback/')}>{u.myFeedback}</a>
      <button type="button" class="item" data-logout>{u.signOut}</button>
      <button type="button" class="item danger" data-delete>{u.deleteAccount}</button>
    </div>
  </details>

  <p class="toast" role="status" aria-live="polite" data-toast hidden></p>
</div>

<script>
  import { getMe, loginHref, markSignedOut, onSignedOut, type Me } from '../lib/auth-client';
  import { ui, type Lang } from '../lib/i18n';

  const root = document.querySelector<HTMLElement>('[data-auth]');
  if (root) {
    const u = ui[(root.dataset.lang as Lang) ?? 'zh'].auth;
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const out = $<HTMLDetailsElement>('[data-auth-out]');
    const inn = $<HTMLDetailsElement>('[data-auth-in]');
    const toast = $<HTMLParagraphElement>('[data-toast]');
    const providerName: Record<string, string> = { google: 'Google', github: 'GitHub', apple: 'Apple' };

    const say = (msg: string) => {
      toast.textContent = msg;
      toast.hidden = false;
      setTimeout(() => (toast.hidden = true), 4000);
    };

    const showSignedOut = () => {
      inn.hidden = true;
      inn.open = false;
      out.hidden = false;
    };

    const showSignedIn = (me: Me) => {
      // 一律用 textContent 写入，用户资料中的任何字符都不会被当作 HTML
      $('[data-name]').textContent = me.name;
      $('[data-email]').textContent = me.email ?? '';
      $('[data-via]').textContent = u.via(me.providers.map((p) => providerName[p] ?? p).join(' / '));
      $('[data-initial]').textContent = [...me.name.trim()][0]?.toUpperCase() ?? '?';
      const img = $<HTMLImageElement>('[data-avatar]');
      if (me.avatarUrl) {
        img.onload = () => (img.hidden = false);
        img.onerror = () => (img.hidden = true);
        img.src = me.avatarUrl;
      }
      out.hidden = true;
      out.open = false;
      inn.hidden = false;
    };

    // 登录后回到当前页面（含查询参数）；页面里其他登录按钮（如反馈页）一并处理
    document.querySelectorAll<HTMLAnchorElement>('[data-login]').forEach((a) => (a.href = loginHref(a.dataset.login!)));

    // 回调页通过 hash 告知登录结果
    const flag = location.hash.slice(1);
    if (flag === 'login-failed' || flag === 'login-cancelled') {
      say(flag === 'login-failed' ? u.failed : u.cancelled);
      history.replaceState(null, '', location.pathname + location.search);
    }

    getMe().then((me) => me && showSignedIn(me));
    onSignedOut(showSignedOut);

    $('[data-logout]').addEventListener('click', async () => {
      const r = await fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' }).catch(() => null);
      if (r?.ok) markSignedOut();
      else say(u.error);
    });

    $('[data-delete]').addEventListener('click', async () => {
      if (!confirm(u.deleteConfirm)) return;
      const r = await fetch('/api/me', { method: 'DELETE', credentials: 'same-origin' }).catch(() => null);
      if (r?.ok) {
        markSignedOut();
        say(u.deleted);
      } else say(u.error);
    });

    // 点击菜单外部时收起
    document.addEventListener('click', (e) => {
      for (const d of [out, inn]) if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') for (const d of [out, inn]) d.open = false;
    });
  }
</script>

<style>
  .auth { position: relative; }
  .pop > summary { list-style: none; cursor: pointer; }
  .pop > summary::-webkit-details-marker { display: none; }
  .avatar { width: 30px; height: 30px; border-radius: 50%; overflow: hidden; display: grid; place-items: center; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; font-size: 13px; font-weight: 600; }
  .avatar img { width: 100%; height: 100%; object-fit: cover; grid-area: 1 / 1; }
  .avatar span { grid-area: 1 / 1; }
  .avatar img:not([hidden]) + span { visibility: hidden; }
  .panel { position: absolute; right: 0; top: 40px; width: min(300px, calc(100vw - 32px)); padding: 18px; border-radius: 18px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); display: grid; gap: 10px; z-index: 60; }
  .title { font-size: 15px; font-weight: 600; overflow-wrap: anywhere; }
  .lead-s { font-size: 13px; color: var(--text-2); margin-bottom: 4px; }
  .fine { font-size: 12px; color: var(--text-3); overflow-wrap: anywhere; }
  .fine a { color: var(--accent); }
  hr { border: 0; border-top: 1px solid var(--line); margin: 4px 0; }
  .item { display: block; text-align: left; padding: 8px 10px; margin: 0 -10px; border-radius: 10px; background: none; border: 0; font: inherit; font-size: 14px; color: var(--text); cursor: pointer; }
  .item:hover { background: var(--surface-2); }
  .danger { color: #d93a3a; }
  @media (max-width: 640px) {
    .panel { position: fixed; top: calc(var(--nav-h) + 6px); left: 16px; right: 16px; width: auto; }
  }
  .toast { position: fixed; left: 50%; top: calc(var(--nav-h) + 12px); transform: translateX(-50%); padding: 10px 18px; border-radius: 14px; text-align: center; width: max-content; background: var(--text); color: var(--bg); font-size: 14px; box-shadow: var(--shadow); z-index: 70; max-width: calc(100vw - 32px); }
</style>
