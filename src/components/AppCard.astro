---
import { downloadURL } from '../lib/download-url';
/** 首页软件卡片。featured 为 true 时显示为横跨整行的大卡片，并带截图。 */
import { Image } from 'astro:assets';
import PlatformBadges from './PlatformBadges.astro';
import AppIcon from './AppIcon.astro';
import { latestAppDownload, type App, type Release } from '../lib/apps';
import { href, t, ui, type Lang } from '../lib/i18n';

interface Props { app: App; releases: Release[]; lang: Lang }
const { app, releases, lang } = Astro.props;
const u = ui[lang];
const d = app.data;
const latest = latestAppDownload(app, releases);
const page = href(lang, `/apps/${app.id}/`);
const shot = d.gallery[0];
const platforms = d.platforms.map((p) => p.id).join(' ');
---
<article class:list={['card', 'app-card', { feat: d.featured }]} data-platforms={platforms}>
  <div class="body">
    <a href={page} class="app-icon-link" aria-hidden="true" tabindex="-1">
      <AppIcon app={app} />
    </a>
    <PlatformBadges app={app} lang={lang} />
    <h3><a href={page}>{d.name}</a></h3>
    <p>{t(d.summary, lang)}</p>
    <a class="community-summary" href={`${page}#reviews`} data-community-summary={app.id} data-lang={lang}>{lang === 'zh' ? '评分与评论 →' : 'Ratings & reviews →'}</a>
    <div class="download-total" data-download-total={app.id} data-lang={lang} aria-live="polite">
      <span>{lang === 'zh' ? '累计下载' : 'Total downloads'}</span>
      <strong data-download-count>—</strong>
    </div>
    {d.featured && d.cardStats.length > 0 && (
      <div class="specs">
        {d.cardStats.map((s) => <div><b>{t(s.value, lang)}</b>{t(s.label, lang)}</div>)}
      </div>
    )}
    <div class="cta">
      {latest?.download && (
        <a class="btn btn-p" href={downloadURL(app.id, latest.version)}>↓ {u.macDownload(latest.version)}</a>
      )}
      <a class="btn btn-s" href={page}>{u.learnMore} →</a>
    </div>
  </div>
  {d.featured && shot && (
    <a class="shot" href={page} tabindex="-1" aria-hidden="true">
      <Image src={lang === 'en' && shot.en ? shot.en : shot.zh} alt="" widths={[480, 800, 1120]} sizes="(max-width: 900px) calc(100vw - 64px), 560px" quality={75} loading="lazy" />
    </a>
  )}
</article>

<script>
  const totals = document.querySelectorAll<HTMLElement>('[data-download-total]');
  if (totals.length) {
    void fetch('/api/downloads', { credentials: 'omit' }).then(async response => {
      if (!response.ok) throw new Error('unavailable');
      const data: { startedAt: number; apps: { appId: string; total: number }[] } = await response.json();
      if (!Number.isFinite(data.startedAt) || !Array.isArray(data.apps)) throw new Error('invalid_stats');
      for (const row of totals) {
        const zh = row.dataset.lang === 'zh';
        const total = data.apps.find(app => app.appId === row.dataset.downloadTotal)?.total ?? 0;
        if (!Number.isSafeInteger(total) || total < 0) continue;
        row.querySelector('[data-download-count]')!.textContent = total.toLocaleString(zh ? 'zh-CN' : 'en-US');
        const since = new Intl.DateTimeFormat(zh ? 'zh-CN' : 'en-US', { timeZone: 'Asia/Shanghai', dateStyle: 'medium' }).format(data.startedAt);
        row.title = zh ? `自 ${since} 起本站发起的下载次数，含各版本；不含 App Store，不代表安装人数。` : `Download requests through this site since ${since}, across all versions. Excludes App Store downloads; not unique installs.`;
      }
    }).catch(() => {
      for (const row of totals) row.querySelector('[data-download-count]')!.textContent = row.dataset.lang === 'zh' ? '暂不可用' : 'Unavailable';
    });
  }
  const summaries = document.querySelectorAll<HTMLElement>('[data-community-summary]');
  const loadSummaries = () => fetch('/api/community', { credentials: 'omit' }).then(async r => {
    if (!r.ok) return;
    const data = await r.json();
    for (const link of summaries) {
      const s = data.apps.find((a: { appId: string }) => a.appId === link.dataset.communitySummary);
      const zh = link.dataset.lang === 'zh';
      link.textContent = `${s?.ratings ? `★ ${Number(s.average).toFixed(1)} (${s.ratings})` : zh ? '暂无评分' : 'No ratings yet'} · ♡ ${s?.likes ?? 0} · ${zh ? '评论 →' : 'Reviews →'}`;
    }
  }).catch(() => { /* Keep the working reviews link when the summary is unavailable. */ });
  if (summaries.length) {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        observer.disconnect(); void loadSummaries();
      }, { rootMargin: '300px' });
      summaries.forEach(link => observer.observe(link.closest('article')!));
    } else { void loadSummaries(); }
  }
</script>

<style>
  .app-card { display: flex; flex-direction: column; transition: transform 0.25s; }
  .app-card:hover { transform: translateY(-3px); }
  .app-card[hidden] { display: none; }
  .app-card .badges { margin: 18px 0 12px; }
  .app-card h3 a:hover { color: var(--accent); }
  .app-card p { margin-top: 6px; }
  .community-summary { font-size: 13px; color: var(--text-2); margin-top: 14px; width: fit-content; }.community-summary:hover { color: var(--accent); }
  .download-total { display: flex; align-items: baseline; gap: 8px; margin-top: 10px; color: var(--text-2); font-size: 13px; }
  .download-total strong { color: var(--text); font-size: 16px; font-weight: 650; font-variant-numeric: tabular-nums; }
  .app-icon-link { display: block; width: fit-content; margin-left: -6px; }
  .body { display: flex; flex-direction: column; height: 100%; }
  .body > .cta { margin-top: auto; padding-top: 26px; }
  .feat { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; padding: 40px; align-items: center; }
  .feat h3 { font-size: 34px; }
  .specs { display: flex; gap: 22px; margin-top: 22px; font-size: 13px; color: var(--text-3); flex-wrap: wrap; }
  .specs b { display: block; color: var(--text); font-size: 15px; }
  .cta { margin-top: 26px; }
  .shot { display: block; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 20px 50px rgba(0, 0, 0, 0.14); }
  @media (max-width: 900px) {
    .feat { grid-template-columns: 1fr; padding: 28px; gap: 28px; }
  }
  @media (max-width: 640px) {
    .feat { padding: 22px; }
    .feat h3 { font-size: 28px; }
  }
</style>
