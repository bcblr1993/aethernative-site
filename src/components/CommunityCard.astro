---
import { site, ui, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = ui[lang].community;
---
<aside class="community" aria-label={copy.nav}>
  <svg class="community-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="m21 3-7 18-4-7-7-4 18-7Z" />
    <path d="m10 14 6-6" />
  </svg>
  <div class="community-copy">
    <h2>{copy.title}</h2>
    <p>{copy.description}</p>
  </div>
  <a class="btn btn-s btn-sm" href={site.telegram} target="_blank" rel="noopener noreferrer">{copy.join} ↗</a>
</aside>

<style>
  .community { display: flex; align-items: center; gap: 18px; padding: 22px 24px; margin-bottom: 28px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .community-icon { width: 28px; height: 28px; flex: none; color: var(--accent); }
  .community-copy { flex: 1; min-width: 0; }
  h2 { font-size: 18px; line-height: 1.4; margin-bottom: 5px; }
  p { font-size: 14px; line-height: 1.65; color: var(--text-2); }
  .btn { flex: none; }
  @media (max-width: 640px) {
    .community { flex-wrap: wrap; gap: 14px; padding: 20px; }
    .community-icon { align-self: flex-start; margin-top: 3px; }
    .community-copy { flex-basis: calc(100% - 42px); }
    .btn { width: 100%; }
  }
</style>
