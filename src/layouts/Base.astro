---
import '../styles/global.css';
import AuthMenu from '../components/AuthMenu.astro';
import BrandMark from '../components/BrandMark.astro';
import { altHref, href, site, ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** 页面标题（会自动加上站点名） */
  title?: string;
  description?: string;
  /** 分享预览图（绝对或站内路径） */
  image?: string;
  /** 导航中高亮的项 */
  current?: 'apps' | 'news' | 'about' | 'support';
  /** 独立页面（如 404）：没有另一种语言的对应页，也不输出 canonical */
  standalone?: boolean;
}
const { lang, title, description, image, current, standalone = false } = Astro.props;
const u = ui[lang];
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${u.tagline}`;
const desc = description ?? u.description;
const path = Astro.url.pathname;
const zhPath = standalone ? '/' : lang === 'zh' ? path : altHref(path, 'en');
const enPath = standalone ? '/en/' : lang === 'en' ? path : altHref(path, 'zh');
const canonical = new URL(path, Astro.site);
const ogImage = new URL(image ?? '/og.png', Astro.site);
const nav = [
  { key: 'apps', label: u.nav.apps, to: href(lang, '/#apps') },
  { key: 'why', label: u.nav.why, to: href(lang, '/#why') },
  { key: 'news', label: u.nav.news, to: href(lang, '/news/') },
  { key: 'about', label: u.nav.about, to: href(lang, '/about/') },
  { key: 'support', label: u.nav.support, to: href(lang, '/support/') },
];
---
<!doctype html>
<html lang={u.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // OAuth 和 __Host- 会话均属于主域名，避免 www 入口显示另一套登录状态。
      if (location.hostname === 'www.aethernative.com') {
        location.replace('https://aethernative.com' + location.pathname + location.search + location.hash);
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {standalone ? <meta name="robots" content="noindex" /> : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="zh-CN" href={new URL(zhPath, Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(zhPath, Astro.site)} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // 默认跟随系统外观；用户点 ◐ 选了与系统不同的外观时记在 color-scheme 里，系统变化时实时更新
      (() => {
        const root = document.documentElement;
        const mq = matchMedia('(prefers-color-scheme: dark)');
        const saved = () => { try { return localStorage.getItem('color-scheme'); } catch (_) { return null; } };
        const apply = () => {
          const s = saved();
          root.dataset.theme = s === 'dark' || s === 'light' ? s : mq.matches ? 'dark' : 'light';
        };
        apply();
        mq.addEventListener('change', apply);
        addEventListener('pageshow', (e) => e.persisted && apply()); // 前进/后退缓存恢复时，同步在其他页面做的选择
        try { localStorage.removeItem('theme'); } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">{u.skip}</a>
    <nav class="nav" aria-label={lang === 'zh' ? '主导航' : 'Main'}>
      <div class="wrap">
        <a class="brand" href={href(lang)}><BrandMark />{site.name}</a>
        <div class="links">
          {nav.map((n) => <a href={n.to} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
        </div>
        <div class="nav-r">
          <a class="icon-btn" data-language-switch href={lang === 'zh' ? enPath : zhPath} hreflang={lang === 'zh' ? 'en' : 'zh-CN'} aria-label={u.switchLangLabel}>{u.switchLang}</a>
          <button class="icon-btn" type="button" data-theme-toggle aria-label={u.theme}>◐</button>
          <AuthMenu lang={lang} />
          <details class="menu">
            <summary class="icon-btn" aria-label={lang === 'zh' ? '菜单' : 'Menu'}>☰</summary>
            <div class="menu-panel">{nav.map((n) => <a href={n.to}>{n.label}</a>)}</div>
          </details>
        </div>
      </div>
    </nav>
    <main id="content">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {site.name} · {u.madeBy}</span>
        <div class="fl">
          <a href={href(lang, '/privacy/')}>{u.privacy}</a>
          <a href={href(lang, '/support/')}>{u.nav.support}</a>
          <a href={href(lang, '/about/')}>{u.nav.about}</a>
          <a href={site.github} rel="noopener">GitHub ↗</a>
          <a href={site.telegram} target="_blank" rel="noopener noreferrer">{u.community.nav} ↗</a>
        </div>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const languageLink = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
      const syncLanguageLink = () => {
        if (!languageLink) return;
        const url = new URL(languageLink.href);
        url.search = location.search;
        url.hash = location.hash;
        languageLink.href = url.href;
      };
      syncLanguageLink();
      window.addEventListener('hashchange', syncLanguageLink);
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.dataset.theme = next;
        // 切回与系统一致的外观时清除记录，恢复跟随系统
        try {
          if (next === system) localStorage.removeItem('color-scheme');
          else localStorage.setItem('color-scheme', next);
        } catch (_) {}
      });
      // 点击菜单里的链接后收起手机菜单
      document.querySelectorAll<HTMLAnchorElement>('.menu-panel a').forEach((a) =>
        a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
      );
      const mobileMenu = document.querySelector<HTMLDetailsElement>('.menu');
      document.addEventListener('click', (event) => {
        if (mobileMenu?.open && !mobileMenu.contains(event.target as Node)) mobileMenu.open = false;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobileMenu?.open) {
          mobileMenu.open = false;
          mobileMenu.querySelector('summary')?.focus();
        }
      });
      matchMedia('(max-width: 900px)').addEventListener('change', () => {
        if (mobileMenu) mobileMenu.open = false;
      });
      // 复制 SHA-256
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? '');
            const label = btn.textContent;
            btn.textContent = btn.dataset.done ?? '✓';
            setTimeout(() => (btn.textContent = label), 1500);
          } catch (_) {
            // 剪贴板不可用时保留可手动复制的内容，并明确提示。
            const value = btn.previousElementSibling;
            if (value) {
              const range = document.createRange();
              range.selectNodeContents(value);
              const selection = window.getSelection();
              selection?.removeAllRanges(); selection?.addRange(range);
            }
            const label = btn.textContent;
            btn.textContent = root.lang.startsWith('zh') ? '请手动复制' : 'Copy manually';
            setTimeout(() => (btn.textContent = label), 2500);
          }
        }),
      );
    </script>
    <style>
      .menu { display: none; position: relative; }
      .menu > summary { list-style: none; }
      .menu > summary::-webkit-details-marker { display: none; }
      .menu-panel { position: absolute; right: 0; top: 40px; min-width: 180px; padding: 8px; border-radius: 16px; background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); display: grid; }
      .menu-panel a { padding: 10px 12px; border-radius: 10px; font-size: 15px; }
      .menu-panel a:hover { background: var(--surface-2); }
      @media (max-width: 900px) { .menu { display: block; } }
    </style>
  </body>
</html>
