---
import '../styles/global.css';
import AuthMenu from '../components/AuthMenu.astro';
import ReplyNotifications from '../components/ReplyNotifications.astro';
import BrandMark from '../components/BrandMark.astro';
import { getApps } from '../lib/apps';
import { altHref, href, site, t, ui, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  /** 页面标题（会自动加上站点名） */
  title?: string;
  description?: string;
  /** 分享预览图（绝对或站内路径） */
  image?: string;
  /** 导航中高亮的项 */
  current?: 'apps' | 'news' | 'about' | 'support';
  /** 独立页面（如 404）：没有另一种语言的对应页，也不输出 canonical */
  standalone?: boolean;
}
const { lang, title, description, image, current, standalone = false } = Astro.props;
const u = ui[lang];
const zh = lang === 'zh';
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${u.tagline}`;
const desc = description ?? u.description;
const path = Astro.url.pathname;
const isAdmin = path.startsWith('/admin');
const zhPath = standalone ? '/' : lang === 'zh' ? path : altHref(path, 'en');
const enPath = standalone ? '/en/' : lang === 'en' ? path : altHref(path, 'zh');
const canonical = new URL(path, Astro.site);
const ogImage = new URL(image ?? '/og.png', Astro.site);
const nav = [
  { key: 'apps', label: u.nav.apps, to: href(lang, '/#apps') },
  { key: 'why', label: u.nav.why, to: href(lang, '/#why') },
  { key: 'news', label: u.nav.news, to: href(lang, '/news/') },
  { key: 'about', label: u.nav.about, to: href(lang, '/about/') },
  { key: 'support', label: u.nav.support, to: href(lang, '/support/') },
];
const footerApps = isAdmin ? [] : (await getApps()).slice(0, 6);
---
<!doctype html>
<html lang={u.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // OAuth 和 __Host- 会话均属于主域名，避免 www 入口显示另一套登录状态。
      if (location.hostname === 'www.aethernative.com') {
        location.replace('https://aethernative.com' + location.pathname + location.search + location.hash);
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {standalone ? <meta name="robots" content="noindex" /> : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="zh-CN" href={new URL(zhPath, Astro.site)} />
        <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(zhPath, Astro.site)} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // 默认跟随系统外观；用户点外观切换选了与系统不同的外观时记在 color-scheme 里，系统变化时实时更新
      (() => {
        const root = document.documentElement;
        const mq = matchMedia('(prefers-color-scheme: dark)');
        const saved = () => { try { return localStorage.getItem('color-scheme'); } catch (_) { return null; } };
        const apply = () => {
          const s = saved();
          root.dataset.theme = s === 'dark' || s === 'light' ? s : mq.matches ? 'dark' : 'light';
        };
        apply();
        mq.addEventListener('change', apply);
        addEventListener('pageshow', (e) => e.persisted && apply()); // 前进/后退缓存恢复时，同步在其他页面做的选择
        try { localStorage.removeItem('theme'); } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">{u.skip}</a>
    <nav class="nav" aria-label={zh ? '主导航' : 'Main'}>
      <div class="wrap">
        <a class="brand" aria-label={site.name} href={href(lang)}><BrandMark /><span class="brand-name">{site.name}</span></a>
        <div class="links">
          {nav.map((n) => <a href={n.to} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
        </div>
        <div class="nav-r">
          <a class="icon-btn" data-language-switch href={lang === 'zh' ? enPath : zhPath} hreflang={lang === 'zh' ? 'en' : 'zh-CN'} aria-label={u.switchLangLabel}>{u.switchLang}</a>
          <button class="icon-btn icon-sq" type="button" data-theme-toggle aria-label={u.theme} title={u.theme}>
            <svg class="theme-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
            <svg class="theme-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
            </svg>
          </button>
          <ReplyNotifications lang={lang} />
          <AuthMenu lang={lang} />
          <details class="menu">
            <summary class="icon-btn icon-sq" aria-label={zh ? '菜单' : 'Menu'}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path class="m-top" d="M4 8.5h16" />
                <path class="m-bot" d="M4 15.5h16" />
              </svg>
            </summary>
            <div class="menu-panel">
              {nav.map((n) => <a href={n.to} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
            </div>
          </details>
        </div>
      </div>
    </nav>
    <main id="content">
      <slot />
    </main>
    {isAdmin ? (
      <footer class="footer footer-compact">
        <div class="wrap">
          <span>© {new Date().getFullYear()} {site.name} · {u.madeBy}</span>
          <div class="fl">
            <a href={href(lang, '/privacy/')}>{u.privacy}</a>
            <a href={href(lang, '/support/')}>{u.nav.support}</a>
            <a href={href(lang, '/about/')}>{u.nav.about}</a>
            <a href={site.github} rel="noopener">GitHub ↗</a>
            <a href={site.telegram} target="_blank" rel="noopener noreferrer">{u.community.nav} ↗</a>
          </div>
        </div>
      </footer>
    ) : (
      <footer class="footer footer-dir">
        <div class="wrap">
          <div class="footer-grid">
            <div class="footer-brand-col">
              <a class="f-brand" href={href(lang)}>
                <BrandMark />
                <span>{site.name}</span>
              </a>
              <p class="f-bio">
                {zh
                  ? `专为 Apple M 系列芯片深度优化的原生 Mac 软件（支持 macOS 26 及以上系统），由${t(site.author, lang)}独立打造。`
                  : `Native macOS apps deeply optimized for Apple M-series chips (macOS 26 or later), crafted by ${t(site.author, lang)}.`}
              </p>
              <span class="f-badge">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="6" y="6" width="12" height="12" rx="2" />
                  <path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4" />
                </svg>
                {zh ? 'Apple M 系列芯片 · macOS 26+' : 'Apple M-Series · macOS 26+'}
              </span>
            </div>
            <div class="footer-col">
              <h2 class="f-heading">{zh ? '软件作品' : 'Apps'}</h2>
              {footerApps.map((app) => (
                <a href={href(lang, `/apps/${app.id}/`)}>{app.data.name}</a>
              ))}
              <a class="f-more" href={href(lang, '/#apps')}>{zh ? '全部软件 →' : 'All apps →'}</a>
            </div>
            <div class="footer-col">
              <h2 class="f-heading">{zh ? '支持与动态' : 'Support & News'}</h2>
              <a href={href(lang, '/news/')}>{u.news.title}</a>
              <a href={href(lang, '/support/')}>{u.nav.support}</a>
              <a href={href(lang, '/feedback/')}>{u.feedback.title}</a>
              <a href={href(lang, '/about/')}>{u.nav.about}</a>
            </div>
            <div class="footer-col">
              <h2 class="f-heading">{zh ? '条款与社区' : 'Legal & Community'}</h2>
              <a href={href(lang, '/privacy/')}>{u.privacy}</a>
              <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
              <a href={site.telegram} target="_blank" rel="noopener noreferrer">{u.community.nav} ↗</a>
            </div>
          </div>
          <div class="footer-bottom">
            <span>© {new Date().getFullYear()} {site.name} · {u.madeBy}</span>
            <span>{u.footer}</span>
          </div>
        </div>
      </footer>
    )}
    <script>
      const root = document.documentElement;
      const languageLink = document.querySelector<HTMLAnchorElement>('[data-language-switch]');
      const syncLanguageLink = () => {
        if (!languageLink) return;
        const url = new URL(languageLink.href);
        url.search = location.search;
        url.hash = location.hash;
        languageLink.href = url.href;
      };
      syncLanguageLink();
      window.addEventListener('hashchange', syncLanguageLink);
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        const system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.dataset.theme = next;
        // 切回与系统一致的外观时清除记录，恢复跟随系统
        try {
          if (next === system) localStorage.removeItem('color-scheme');
          else localStorage.setItem('color-scheme', next);
        } catch (_) {}
      });
      // 点击菜单里的链接后收起手机菜单
      document.querySelectorAll<HTMLAnchorElement>('.menu-panel a').forEach((a) =>
        a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
      );
      // Keep navigation popovers mutually exclusive, including keyboard activation.
      const navMenus = document.querySelectorAll<HTMLDetailsElement>('.nav details');
      navMenus.forEach(menu => menu.addEventListener('toggle', () => {
        if (menu.open) navMenus.forEach(other => { if (other !== menu) other.open = false; });
      }));
      const mobileMenu = document.querySelector<HTMLDetailsElement>('.menu');
      document.addEventListener('click', (event) => {
        if (mobileMenu?.open && !mobileMenu.contains(event.target as Node)) mobileMenu.open = false;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobileMenu?.open) {
          mobileMenu.open = false;
          mobileMenu.querySelector('summary')?.focus();
        }
      });
      matchMedia('(max-width: 900px)').addEventListener('change', () => {
        if (mobileMenu) mobileMenu.open = false;
      });
      // 复制 SHA-256
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? '');
            const label = btn.textContent;
            btn.textContent = btn.dataset.done ?? '✓';
            setTimeout(() => (btn.textContent = label), 1500);
          } catch (_) {
            // 剪贴板不可用时保留可手动复制的内容，并明确提示。
            const value = btn.previousElementSibling;
            if (value) {
              const range = document.createRange();
              range.selectNodeContents(value);
              const selection = window.getSelection();
              selection?.removeAllRanges(); selection?.addRange(range);
            }
            const label = btn.textContent;
            btn.textContent = root.lang.startsWith('zh') ? '请手动复制' : 'Copy manually';
            setTimeout(() => (btn.textContent = label), 2500);
          }
        }),
      );
      // 渐进式滚动显现：仅在允许动画且支持 IntersectionObserver 时启用，首屏与超长等待均兜底可见
      const revealNodes = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      if (
        !matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      ) {
        const markVisible = (el: Element) => el.classList.add('is-visible');
        const vh = window.innerHeight || document.documentElement.clientHeight;
        const pending: HTMLElement[] = [];
        for (const el of revealNodes) {
          const rect = el.getBoundingClientRect();
          if (rect.top <= vh) {
            markVisible(el);
          } else {
            pending.push(el);
          }
        }
        root.classList.add('reveal-ready');
        if (pending.length > 0) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting || entry.boundingClientRect.top <= window.innerHeight) {
                  markVisible(entry.target);
                  io.unobserve(entry.target);
                }
              }
            },
            { rootMargin: '0px 0px -40px 0px', threshold: 0.01 },
          );
          pending.forEach((el) => io.observe(el));
          window.setTimeout(() => {
            pending.forEach(markVisible);
            io.disconnect();
          }, 1500);
        }
      }
    </script>
    <style>
      .icon-sq { width: 32px; padding: 0; }
      .theme-sun { display: none; }
      .theme-moon { display: block; }
      :global(:root[data-theme='dark']) .theme-sun { display: block; }
      :global(:root[data-theme='dark']) .theme-moon { display: none; }

      .menu { display: none; position: relative; }
      .menu > summary { list-style: none; }
      .menu > summary::-webkit-details-marker { display: none; }
      .menu path { transition: transform 0.22s var(--ease-out); }
      .m-top { transform-origin: 12px 8.5px; }
      .m-bot { transform-origin: 12px 15.5px; }
      .menu[open] .m-top { transform: translateY(3.5px) rotate(45deg); }
      .menu[open] .m-bot { transform: translateY(-3.5px) rotate(-45deg); }
      .menu-panel {
        position: absolute;
        right: 0;
        top: 42px;
        min-width: 200px;
        padding: 8px;
        border-radius: 18px;
        background: var(--surface);
        border: 1px solid var(--line-strong);
        box-shadow: var(--shadow-lg), var(--specular);
        display: grid;
        gap: 2px;
        z-index: 60;
      }
      .menu-panel a {
        padding: 10px 14px;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 500;
        color: var(--text-2);
        transition: background-color 0.15s var(--ease-out), color 0.15s var(--ease-out);
      }
      .menu-panel a:hover { background: var(--surface-2); color: var(--text); }
      .menu-panel a[aria-current='page'] { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
      @media (max-width: 900px) { .menu { display: block; } }

      .footer-dir { padding: 64px 0 44px; background: var(--bg-alt); }
      .footer-grid {
        display: grid;
        grid-template-columns: minmax(240px, 1.55fr) repeat(3, minmax(0, 1fr));
        gap: 44px;
      }
      .footer-brand-col {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
      }
      .f-brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--text);
        font-weight: 650;
        font-size: 16px;
        letter-spacing: -0.015em;
      }
      .f-bio {
        font-size: 13.5px;
        line-height: 1.65;
        color: var(--text-2);
        max-width: 280px;
      }
      .f-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 999px;
        background: var(--surface);
        border: 1px solid var(--line);
        box-shadow: var(--specular);
        color: var(--text-2);
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 0.01em;
      }
      .footer-col {
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-width: 0;
      }
      .f-heading {
        font-size: 12px;
        font-weight: 650;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text);
        line-height: 1.4;
        margin-bottom: 4px;
      }
      .footer-col a {
        font-size: 13.5px;
        line-height: 1.5;
        color: var(--text-2);
        width: fit-content;
      }
      .footer-col a:hover { color: var(--text); }
      .footer-col a.f-more { color: var(--accent); font-weight: 550; margin-top: 2px; }
      .footer-col a.f-more:hover { color: var(--accent-2); }
      .footer-bottom {
        margin-top: 48px;
        padding-top: 24px;
        border-top: 1px solid var(--line);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px 24px;
        flex-wrap: wrap;
        font-size: 12.5px;
        color: var(--text-3);
      }
      @media (max-width: 900px) {
        .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
        .footer-brand-col { grid-column: 1 / -1; }
      }
      @media (max-width: 540px) {
        .footer-dir { padding: 48px 0 36px; }
        .footer-grid { gap: 28px 20px; }
        .footer-bottom { margin-top: 36px; padding-top: 20px; }
      }
    </style>
  </body>
</html>
