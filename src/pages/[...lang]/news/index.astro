---
/** 官方动态：公告 + 各软件版本（与 /feed.json、iPhone App 首页内容一致），置顶的排在最前。 */
import Base from '../../../layouts/Base.astro';
import AppIcon from '../../../components/AppIcon.astro';
import { buildFeed, type FeedItem } from '../../../lib/feed';
import { getApps } from '../../../lib/apps';
import { getAppInputs, getNewsInputs } from '../../../lib/feed-data';
import { fmtDate, langParams, ui, type Lang } from '../../../lib/i18n';

export const getStaticPaths = langParams;

const { lang } = Astro.props as { lang: Lang };
const u = ui[lang];
const zh = lang === 'zh';
const apps = await getAppInputs();
const names = new Map(apps.map((a) => [a.id, a.name]));
const appMap = new Map((await getApps()).map((a) => [a.id, a]));
const { items } = buildFeed({ site: Astro.site!, apps, news: await getNewsInputs() });
const sorted = [...items.filter((i) => i.pinned), ...items.filter((i) => !i.pinned)];
const path = (i: FeedItem) => new URL(i.url[lang]).pathname;
const kind = (i: FeedItem) =>
  i.kind === 'news' ? u.news.announcement : i.release?.channel === 'beta' ? u.beta : u.news.release;
const badgeClass = (i: FeedItem) =>
  i.kind === 'news' ? 'ok' : i.release?.channel === 'beta' ? 'soon' : 'gray';
const appOf = (i: FeedItem) =>
  (i.kind === 'release' || i.appIds.length === 1) && i.appIds[0] ? appMap.get(i.appIds[0]) : undefined;
---
<Base lang={lang} title={u.news.title} description={u.news.lead} current="news">
  <div class="wrap news-page">
    <header class="page-hero">
      <p class="eyebrow">Aether Native · {zh ? '更新日志' : 'Dispatch'}</p>
      <h1>{u.news.title}</h1>
      <p class="hero-lead">{u.news.lead}</p>
      {sorted.length > 0 && (
        <p class="feed-stat">
          {zh ? `最近 ${sorted.length} 条动态` : `Latest ${sorted.length} updates`}
        </p>
      )}
    </header>

    <div class="list">
      {sorted.map((i) => {
        const iconApp = appOf(i);
        const relatedNames = i.kind === 'news' && i.appIds.length > 0
          ? i.appIds.map((id) => names.get(id)).filter(Boolean)
          : [];
        return (
          <a class:list={['card', 'item', { pinned: i.pinned }]} href={path(i)}>
            <div class="item-media">
              {iconApp ? (
                <AppIcon app={iconApp} size={42} />
              ) : (
                <span class="news-icon-tile" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m3 11 18-5v12L3 14v-3Z" />
                    <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" />
                  </svg>
                </span>
              )}
            </div>

            <div class="item-body">
              <div class="meta">
                {i.pinned && (
                  <span class="badge pin-badge">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 17v5" />
                      <path d="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1Z" />
                    </svg>
                    {u.news.pinned}
                  </span>
                )}
                <span class:list={['badge', badgeClass(i)]}>{kind(i)}</span>
                <time class="meta-date" datetime={i.date.slice(0, 10)}>{fmtDate(new Date(i.date), lang)}</time>
                {relatedNames.length > 0 && (
                  <span class="meta-apps">{relatedNames.join(' · ')}</span>
                )}
              </div>

              <h2>{i.title[lang]}</h2>
              {/* 同步时 Release 正文没写简介会用标题代替，相同时不重复显示 */}
              {i.summary[lang] !== i.title[lang] && <p class="sum">{i.summary[lang]}</p>}
            </div>

            <span class="item-arrow" aria-hidden="true">→</span>
          </a>
        );
      })}
    </div>
  </div>
</Base>

<style>
  .news-page {
    padding-bottom: 72px;
  }
  .hero-lead {
    color: var(--text-2);
    font-size: 17px;
    max-width: 640px;
    line-height: 1.6;
  }
  .feed-stat {
    margin-top: 14px;
    font-size: 13px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .list {
    display: grid;
    gap: 14px;
  }
  .item {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto;
    align-items: start;
    gap: 18px;
    padding: 22px 26px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm, none), var(--specular, none);
    transition:
      transform 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
  }
  .item:hover {
    transform: translateY(-1px);
    border-color: var(--line-strong);
    box-shadow: var(--shadow), var(--specular, none);
  }
  .item:hover h2 {
    color: var(--accent);
  }
  .item:hover .item-arrow {
    color: var(--accent);
    transform: translateX(3px);
  }

  .item.pinned {
    border-color: color-mix(in srgb, var(--accent) 28%, var(--line-strong));
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent-soft) 50%, var(--surface)) 0%,
      var(--surface) 58%
    );
    box-shadow: var(--shadow), inset 0 1px 0 color-mix(in srgb, var(--accent) 14%, transparent);
  }
  .item.pinned:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line-strong));
    box-shadow: var(--shadow-lg, var(--shadow)), inset 0 1px 0 color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .item-media {
    padding-top: 2px;
    flex: none;
  }
  .news-icon-tile {
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--text-2);
    display: grid;
    place-items: center;
  }
  .item.pinned .news-icon-tile {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: color-mix(in srgb, var(--accent) 20%, var(--line));
  }

  .item-body {
    min-width: 0;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 8px 10px;
    flex-wrap: wrap;
    color: var(--text-3);
    font-size: 13.5px;
  }
  .pin-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .meta-date {
    font-variant-numeric: tabular-nums;
    color: var(--text-3);
  }
  .meta-apps {
    color: var(--text-2);
    font-size: 13px;
  }
  .meta-apps::before {
    content: '·';
    margin-right: 10px;
    color: var(--text-3);
  }

  .item h2 {
    font-size: 20px;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin: 10px 0 6px;
    transition: color 0.18s var(--ease-out);
  }
  .sum {
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.62;
  }

  .item-arrow {
    color: var(--text-3);
    font-size: 16px;
    padding-top: 6px;
    transition: transform 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  @media (max-width: 640px) {
    .item {
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 14px;
      padding: 18px;
    }
    .item h2 {
      font-size: 18px;
    }
    .item-arrow {
      display: none;
    }
  }
</style>
