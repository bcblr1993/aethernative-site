---
/** 公告详情：内容来自 src/content/news/<id>.yaml。推送点开后通过 Universal Link 打开 App 内的同一条。 */
import Base from '../../../layouts/Base.astro';
import AppIcon from '../../../components/AppIcon.astro';
import Text from '../../../components/Text.astro';
import { getApps, getNews, type News } from '../../../lib/apps';
import { fmtDate, href, langs, t, ui, type Lang } from '../../../lib/i18n';

export async function getStaticPaths() {
  const news = await getNews();
  return news.flatMap((n) => langs.map((lang) => ({ params: { lang: lang === 'zh' ? undefined : lang, id: n.id }, props: { lang, n } })));
}

const { lang, n } = Astro.props as { lang: Lang; n: News };
const u = ui[lang];
const zh = lang === 'zh';
const d = n.data;
const apps = (await getApps()).filter((a) => d.apps.includes(a.id));
const link = (h: string) => (h.startsWith('/') && !h.startsWith('//') ? href(lang, h) : h);
const isExternal = (h: string) => /^https?:/.test(h);
---
<Base lang={lang} title={t(d.title, lang)} description={t(d.summary, lang)} current="news">
  <div class="wrap news-detail-page">
    <header class="page-hero">
      <nav class="crumb-nav" aria-label={zh ? '面包屑导航' : 'Breadcrumb'}>
        <a class="crumb-back" href={href(lang, '/news/')}>← {u.news.title}</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="crumb-cur" aria-current="page">{u.news.announcement}</span>
      </nav>

      <div class="hero-meta">
        <span class="badge ok">{u.news.announcement}</span>
        {d.pinned && <span class="badge gray">{u.news.pinned}</span>}
        <time class="news-date" datetime={d.date.toISOString().slice(0, 10)}>{fmtDate(d.date, lang)}</time>
      </div>

      <h1><Text v={d.title} lang={lang} /></h1>
      <p class="sum"><Text v={d.summary} lang={lang} /></p>

      {apps.length > 0 && (
        <div class="app-pills" aria-label={zh ? '关联软件' : 'Related apps'}>
          {apps.map((a) => (
            <a class="app-pill" href={href(lang, `/apps/${a.id}/`)}>
              <AppIcon app={a} size={20} />
              <span>{a.data.name}</span>
            </a>
          ))}
        </div>
      )}
    </header>

    <div class="news-body">
      <article class="card news-card">
        {d.body.length > 0 && (
          <div class="news-paragraphs">
            {d.body.map((p) => <p><Text v={p} lang={lang} /></p>)}
          </div>
        )}

        {d.links.length > 0 && (
          <div class:list={['related-block', { 'has-divider': d.body.length > 0 }]}>
            <p class="related-label">{zh ? '相关链接' : 'Related links'}</p>
            <div class="link-grid">
              {d.links.map((l) => {
                const ext = isExternal(l.href);
                return (
                  <a class="link-card" href={link(l.href)} rel={ext ? 'noopener' : undefined}>
                    <span>{t(l.label, lang)}</span>
                    <span class="link-arrow" aria-hidden="true">{ext ? '↗' : '→'}</span>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </article>

      <div class="news-foot">
        <a class="more back-all" href={href(lang, '/news/')}>← {u.news.all}</a>
      </div>
    </div>
  </div>
</Base>

<style>
  .news-detail-page {
    padding-bottom: 72px;
  }

  /* Breadcrumb */
  .crumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 13.5px;
    color: var(--text-3);
  }
  .crumb-back {
    color: var(--text-2);
    transition: color 0.16s var(--ease-out);
  }
  .crumb-back:hover {
    color: var(--text);
  }
  .crumb-sep {
    color: var(--line-strong);
    user-select: none;
  }

  /* Hero */
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .news-date {
    font-size: 13.5px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .page-hero h1 {
    margin: 14px 0 14px;
    max-width: 820px;
  }
  .page-hero .sum {
    margin-top: 12px;
    max-width: 740px;
    color: var(--text-2);
    font-size: 18px;
    line-height: 1.62;
  }

  .app-pills {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 22px;
  }
  .app-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 13px 5px 7px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm, none);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text);
    transition: border-color 0.18s var(--ease-out), background-color 0.18s var(--ease-out), transform 0.18s var(--ease-out);
  }
  .app-pill:hover {
    border-color: var(--line-strong);
    background: var(--surface-2);
    transform: translateY(-1px);
  }

  /* Body */
  .news-body {
    max-width: 800px;
    display: grid;
    gap: 20px;
  }
  .news-card {
    padding: 32px 36px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm, none), var(--specular, none);
  }
  .news-paragraphs {
    display: grid;
    gap: 18px;
  }
  .news-paragraphs p {
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }

  .related-block.has-divider {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .related-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 12px;
  }
  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 10px;
  }
  .link-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    border-radius: var(--radius-sm, 12px);
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--text);
    font-size: 14.5px;
    font-weight: 500;
    transition: border-color 0.18s var(--ease-out), background-color 0.18s var(--ease-out), color 0.18s var(--ease-out);
  }
  .link-card:hover {
    border-color: var(--line-strong);
    background: var(--surface);
    color: var(--accent);
  }
  .link-arrow {
    color: var(--text-3);
    transition: transform 0.18s var(--ease-out), color 0.18s var(--ease-out);
  }
  .link-card:hover .link-arrow {
    color: var(--accent);
    transform: translateX(2px);
  }

  .news-foot {
    padding-top: 4px;
  }

  @media (max-width: 640px) {
    .news-card {
      padding: 22px 20px;
    }
    .page-hero .sum {
      font-size: 16px;
    }
  }
</style>
