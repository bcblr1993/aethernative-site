---
import { downloadURL } from '../../../../lib/download-url';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import ThemeGallery from '../../../../components/ThemeGallery.astro';
import Text from '../../../../components/Text.astro';
import Checksum from '../../../../components/Checksum.astro';
import PlatformBadges from '../../../../components/PlatformBadges.astro';
import { getApps, getReleases, latestStable, type App, type Release } from '../../../../lib/apps';
import { href, langs, t, ui, type Lang } from '../../../../lib/i18n';

export async function getStaticPaths() {
  const apps = await getApps();
  return (
    await Promise.all(
      apps.map(async (app) => {
        const releases = await getReleases(app.id);
        return langs.map((lang) => ({
          params: { lang: lang === 'zh' ? undefined : lang, slug: app.id },
          props: { lang, app, releases },
        }));
      }),
    )
  ).flat();
}

const { lang, app, releases } = Astro.props as { lang: Lang; app: App; releases: Release[] };
const u = ui[lang];
const d = app.data;
const base = href(lang, `/apps/${app.id}/`);
const latest = latestStable(releases);
const previous = latest ? releases.slice(releases.indexOf(latest) + 1).find((r) => r.download) : undefined;
const ios = d.platforms.find((p) => p.id === 'ios');
const iosLink = ios?.appStore ?? ios?.testFlight;
type Shot = (typeof d.gallery)[number];
const shotOf = (s: Shot) => (lang === 'en' && s.en ? s.en : s.zh);
// 深色版截图：英文页优先 enDark，没有时用 zhDark；都没有时该画面只有浅色
const darkOf = (s: Shot) => (lang === 'en' && s.enDark ? s.enDark : s.zhDark);
const hasDark = d.gallery.length > 0 && d.gallery.every((s) => darkOf(s));
// 截图按真实大小的比例显示：最宽的窗口铺满画面区，较小的窗口（设置、菜单栏面板）相应缩小
const widest = Math.max(...d.gallery.map((s) => shotOf(s).width), 1);
const shotWidth = (s: Shot) => Math.max(45, Math.round((shotOf(s).width / widest) * 1000) / 10);
const zh = lang === 'zh';
// 只链接实际存在的文档页（src/content/apps/<id>/docs/*.yaml）
const docIds = new Set((await getCollection('docs')).map((x) => x.id));
const hasDoc = (key: string) => docIds.has(`${app.id}/${key}`);
const docLinks = [
  { key: 'support', label: u.help },
  { key: 'privacy', label: u.privacy },
  { key: 'license', label: u.license },
].filter((l) => hasDoc(l.key));
// 分享预览图与“查看原图”链接需要独立生成的文件（只用 <Image> 引用的原图在构建时不会保留）
const fulls = await Promise.all(d.gallery.map(async (s) => (await getImage({ src: shotOf(s), format: 'webp', quality: 90 })).src));
const fullsDark = hasDark
  ? await Promise.all(d.gallery.map(async (s) => (await getImage({ src: darkOf(s)!, format: 'webp', quality: 90 })).src))
  : [];
const ogImage = d.gallery[0] ? (await getImage({ src: shotOf(d.gallery[0]), width: 1200, format: 'png' })).src : undefined;

const subnav = [
  d.ios && { id: 'ios', label: zh ? 'iOS 版' : 'iPhone' },
  d.protocols && { id: 'protocols', label: zh ? '协议' : 'Protocols' },
  d.features && { id: 'features', label: zh ? '特性' : 'Features' },
  d.benchmarks && { id: 'benchmarks', label: zh ? '实测' : 'Benchmarks' },
  d.faq && { id: 'faq', label: 'FAQ' },
].filter(Boolean) as { id: string; label: string }[];
---
<Base lang={lang} title={d.name} description={t(d.tagline, lang)} current="apps" image={ogImage}>
  <div class="subnav">
    <div class="wrap">
      <a class="sn-name" href="#top">{d.name}</a>
      <div class="sn-links">
        {subnav.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
        {releases.length > 0 && <a href={`${base}releases/`}>{u.releases}</a>}
        {hasDoc('support') && <a href={`${base}support/`}>{u.help}</a>}
      </div>
      {latest?.download && <a class="btn btn-p btn-sm" href={downloadURL(app.id, latest.version)}>{u.download(latest.version)}</a>}
    </div>
  </div>

  <header class="hero" id="top">
    <div class="wrap center">
      <div class:list={['hero-icon', { 'inset-icon': ['aetherfilm', 'aetherscreens'].includes(app.id) }]}><Image src={d.icon} alt={`${d.name} icon`} width={192} height={192} loading="eager" /></div>
      <p class="eyebrow"><Text v={d.hero.eyebrow} lang={lang} /></p>
      <h1><Text v={d.hero.title} lang={lang} /></h1>
      <p class="lead"><Text v={d.hero.lead} lang={lang} /></p>
      <div class="cta">
        {latest?.download && <a class="btn btn-p" href={downloadURL(app.id, latest.version)}>{u.macDownload(latest.version)} ↓</a>}
        {ios && (iosLink
          ? <a class="btn btn-s" href={iosLink}>iPhone ↗</a>
          : d.ios && <a class="btn btn-s" href="#ios">{zh ? 'iPhone 版预告' : 'iPhone preview'} ↓</a>)}
      </div>
      <p class="req muted"><Text v={d.hero.requirements} lang={lang} /></p>
      {d.notice && <p class="notice"><Text v={d.notice} lang={lang} /></p>}
    </div>

    <div class="wrap">
      {d.themeGallery && <ThemeGallery gallery={d.themeGallery} name={d.name} lang={lang} />}
      {!d.themeGallery && d.gallery.length > 0 && (
        <div class="stage" data-reveal data-has-dark={hasDark ? 'true' : undefined} data-look="light">
          <div class="stage-glow" aria-hidden="true"></div>
          <div class="stage-top">
            <span class="eyebrow">{d.name} for Mac</span>
            <div class="stage-tools">
              {hasDark && (
                <div class="seg look-seg" role="group" aria-label={u.look}>
                  <span class="seg-pill" aria-hidden="true"></span>
                  <button type="button" data-look-btn="light" aria-pressed="true">{u.lookLight}</button>
                  <button type="button" data-look-btn="dark" aria-pressed="false">{u.lookDark}</button>
                </div>
              )}
              <a class="more" id="stage-full" href={fulls[0]} target="_blank" rel="noopener">{u.openFull}</a>
            </div>
          </div>
          <div class="stage-shots">
            {d.gallery.map((s, i) => (
              <figure data-shot={i} data-active={i === 0 ? 'true' : undefined} data-seen={i === 0 ? 'true' : undefined} style={`--w: ${shotWidth(s)}%`}>
                <Image class="layer layer-light" src={shotOf(s)} alt={`${d.name} — ${t(s.label, lang)}`} widths={[800, 1400, 2000]} sizes="(max-width: 1120px) 100vw, 1072px" loading={i === 0 ? 'eager' : 'lazy'} data-full={fulls[i]} />
                {hasDark && (
                  <Image class="layer layer-dark" src={darkOf(s)!} alt={`${d.name} — ${t(s.label, lang)} (${u.lookDark})`} widths={[800, 1400, 2000]} sizes="(max-width: 1120px) 100vw, 1072px" loading="lazy" data-full={fullsDark[i]} />
                )}
              </figure>
            ))}
          </div>
          {d.gallery.length > 1 && (
            <div class="seg stage-tabs" role="group" aria-label={u.screenshots}>
              <span class="seg-pill" aria-hidden="true"><i class="seg-progress"></i></span>
              {d.gallery.map((s, i) => (
                <button type="button" data-target={i} aria-pressed={i === 0 ? 'true' : 'false'}>{t(s.label, lang)}</button>
              ))}
            </div>
          )}
        </div>
      )}
      {latest && (
          <div class:list={['release-line', { solo: d.gallery.length === 0 }]}>
            <PlatformBadges app={app} lang={lang} tech={false} />
            <span>{d.name} {latest.version} · <a class="more" href={`${base}releases/${latest.version}/`}>{u.releaseNotes}</a>
              {previous && <> · <a class="more" href={`${base}releases/${previous.version}/`}>{previous.version} {u.previous}</a></>}
            </span>
            {latest.sha256 && <div class="rl-sum"><span class="muted">{u.sha}</span><Checksum value={latest.sha256} lang={lang} /></div>}
          </div>
      )}
    </div>
  </header>

  {d.ios && (
    <section data-reveal id="ios" class="ios">
      <div class="wrap">
        <div class="ios-hero card">
          <div>
            <div class="badges"><span class="badge soon">{d.name} for iOS · <Text v={d.ios.badge} lang={lang} /></span></div>
            <h2><Text v={d.ios.title} lang={lang} /></h2>
            <p class="lead"><Text v={d.ios.lead} lang={lang} /></p>
            <div class="badges chips">{d.ios.chips.map((c) => <span class="badge gray">{c}</span>)}</div>
            <p class="ios-status"><Text v={d.ios.status} lang={lang} /></p>
            <p class="muted small"><Text v={d.ios.requirements} lang={lang} /></p>
            {d.sync && <a class="more" href="#sync">{zh ? '了解多设备同步 ↓' : 'Explore multi-device sync ↓'}</a>}
          </div>
          <div class="phone"><Image src={d.ios.image} alt={`${d.name} iPhone`} widths={[300, 600]} sizes="300px" /></div>
        </div>
        <p class="note"><Text v={d.ios.notice} lang={lang} /></p>
        <div class="grid-3 ios-feats">
          {d.ios.features.map((f) => (
            <div class="card">
              <div class="kicker">{f.kicker}</div>
              <h3><Text v={f.title} lang={lang} /></h3>
              <p><Text v={f.body} lang={lang} /></p>
            </div>
          ))}
        </div>
        <div class="sec-head shots-head">
          <div><div class="eyebrow">A closer look</div><h2><Text v={d.ios.shotsTitle} lang={lang} /></h2></div>
          <p class="muted small"><Text v={d.ios.shotsNote} lang={lang} /></p>
        </div>
        <div class="phones">
          {d.ios.shots.map((s) => (
            <figure>
              <div class="phone"><Image src={s.image} alt={t(s.title, lang)} widths={[300, 600]} sizes="(max-width: 640px) 70vw, 300px" /></div>
              <figcaption><b><Text v={s.title} lang={lang} /></b><Text v={s.caption} lang={lang} /></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.sync && (
    <section data-reveal id="sync" class="sync">
      <div class="wrap">
        <div class="center">
          <div class="eyebrow"><Text v={d.sync.eyebrow} lang={lang} /></div>
          <h2 class="mt"><Text v={d.sync.title} lang={lang} /></h2>
        </div>
        <Image class="sync-art" src={d.sync.image} alt={t(d.sync.imageAlt, lang)} />
        <p class="lead center-block"><Text v={d.sync.lead} lang={lang} /></p>
        <div class="grid-3 mt-lg">
          {d.sync.points.map((p) => (
            <div class="card flat"><h3 class="h4"><Text v={p.title} lang={lang} /></h3><p><Text v={p.body} lang={lang} /></p></div>
          ))}
        </div>
        <p class="note"><Text v={d.sync.note} lang={lang} /></p>
      </div>
    </section>
  )}

  {d.experience && (
    <section data-reveal class="experience">
      <div class="wrap">
        <div class="sec-head"><div><div class="eyebrow"><Text v={d.experience.eyebrow} lang={lang} /></div><h2><Text v={d.experience.title} lang={lang} /></h2></div></div>
        <div class="grid-3">
          {d.experience.cards.map((c) => (
            <div class="card flat"><h3><Text v={c.title} lang={lang} /></h3><p class="mt-sm"><Text v={c.body} lang={lang} /></p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.showcase && (
    <section data-reveal id="showcase" class="showcase">
      <div class="wrap">
        <div class="sec-head"><div>
          <div class="eyebrow"><Text v={d.showcase.eyebrow} lang={lang} /></div>
          <h2><Text v={d.showcase.title} lang={lang} /></h2>
          {d.showcase.lead && <p class="lead"><Text v={d.showcase.lead} lang={lang} /></p>}
        </div></div>
        <div class="sc-grid">
          {d.showcase.items.map((x) => (
            <figure class="card flat">
              <div class="sc-img"><Image src={x.image} alt={t(x.title, lang)} width={Math.round(x.image.width / 2)} densities={[1, 2]} /></div>
              <figcaption><b><Text v={x.title} lang={lang} /></b><Text v={x.caption} lang={lang} /></figcaption>
            </figure>
          ))}
        </div>
        {d.showcase.note && <p class="muted small mt-sm"><Text v={d.showcase.note} lang={lang} /></p>}
      </div>
    </section>
  )}

  {d.protocols && (
    <section data-reveal id="protocols">
      <div class="wrap">
        <div class="sec-head"><div>
          <div class="eyebrow"><Text v={d.protocols.eyebrow} lang={lang} /></div>
          <h2><Text v={d.protocols.title} lang={lang} /></h2>
          <p class="lead"><Text v={d.protocols.lead} lang={lang} /></p>
        </div></div>
        <div class="grid-3 protos">
          {d.protocols.items.map((p) => (
            <details class="card proto">
              <summary><b>{p.name}</b><span>{p.tag}</span></summary>
              <p><Text v={p.body} lang={lang} /></p>
              <div class="badges">{p.chips.map((c) => <span class="badge gray">{c}</span>)}</div>
            </details>
          ))}
        </div>
        {d.protocols.tools.length > 0 && (
          <div class="grid-3 mt-lg">
            {d.protocols.tools.map((x) => (
              <div class="card flat"><h3 class="h4"><Text v={x.title} lang={lang} /></h3><p><Text v={x.body} lang={lang} /></p></div>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {d.features && (
    <section data-reveal id="features">
      <div class="wrap">
        <div class="sec-head"><div>
          <div class="eyebrow"><Text v={d.features.eyebrow} lang={lang} /></div>
          <h2><Text v={d.features.title} lang={lang} /></h2>
          <p class="lead"><Text v={d.features.lead} lang={lang} /></p>
        </div></div>
        <div class="grid-2 feats">
          {d.features.items.map((f, i) => (
            <div class:list={['card', { wide: i === 0 }]}>
              <div class="kicker"><Text v={f.kicker} lang={lang} /></div>
              <h3><Text v={f.title} lang={lang} /></h3>
              <p class="mt-sm"><Text v={f.body} lang={lang} /></p>
              {f.details.length > 0 && (
                <details class="fold">
                  <summary>{u.explore}</summary>
                  <ul class="fold-body">{f.details.map((x) => <li><Text v={x} lang={lang} /></li>)}</ul>
                </details>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.benchmarks && (
    <section data-reveal id="benchmarks">
      <div class="wrap">
        <div class="sec-head"><div>
          <div class="eyebrow"><Text v={d.benchmarks.eyebrow} lang={lang} /></div>
          <h2><Text v={d.benchmarks.title} lang={lang} /></h2>
          <p class="lead"><Text v={d.benchmarks.lead} lang={lang} /></p>
        </div></div>
        <div class="grid-4">
          {d.benchmarks.stats.map((s) => (
            <div class="card bench"><strong><Text v={s.value} lang={lang} /></strong><span><Text v={s.label} lang={lang} /></span><p><Text v={s.note} lang={lang} /></p></div>
          ))}
        </div>
        {d.benchmarks.table && (
          <details class="fold compare">
            <summary>{u.compare}</summary>
            <div class="fold-body table-wrap">
              <table>
                <thead><tr>{d.benchmarks.table.columns.map((c) => <th scope="col"><Text v={c} lang={lang} /></th>)}</tr></thead>
                <tbody>
                  {d.benchmarks.table.rows.map((r) => (
                    <tr>
                      <th scope="row"><Text v={r.metric} lang={lang} /></th>
                      {r.cells.map((c) => <td><b><Text v={c.value} lang={lang} /></b><span><Text v={c.note} lang={lang} /></span></td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
              {d.benchmarks.footnote && <p class="muted small mt-sm"><Text v={d.benchmarks.footnote} lang={lang} /></p>}
            </div>
          </details>
        )}
      </div>
    </section>
  )}

  {d.faq && (
    <section data-reveal id="faq">
      <div class="wrap faq">
        <div>
          <div class="eyebrow"><Text v={d.faq.eyebrow} lang={lang} /></div>
          <h2 class="mt"><Text v={d.faq.title} lang={lang} /></h2>
          <p class="lead mt"><Text v={d.faq.lead} lang={lang} /></p>
          {d.repo && <a class="btn btn-s mt-lg" href={d.repo} rel="noopener">{zh ? '在 GitHub 了解项目 ↗' : 'Explore on GitHub ↗'}</a>}
        </div>
        <div>
          {d.faq.items.map((f) => (
            <details class="fold"><summary><Text v={f.q} lang={lang} /></summary><p class="fold-body"><Text v={f.a} lang={lang} /></p></details>
          ))}
        </div>
      </div>
    </section>
  )}

  {d.cta && (
    <section data-reveal class="final">
      <div class="wrap center">
        <div class="final-icon"><Image src={d.icon} alt="" width={128} height={128} /></div>
        <p class="eyebrow">{d.name} for {d.platforms.map((p) => p.id === 'mac' ? 'Mac' : 'iPhone').join(' & ')}</p>
        <h2 class="mt"><Text v={d.cta.title} lang={lang} /></h2>
        <div class="cta">
          {latest?.download && <a class="btn btn-p" href={downloadURL(app.id, latest.version)}>{u.macDownload(latest.version)} ↓</a>}
          {releases.length > 0 && <a class="btn btn-s" href={`${base}releases/`}>{u.allReleases} →</a>}
        </div>
        <p class="req muted"><Text v={d.cta.note} lang={lang} /></p>
        <nav class="doc-links" aria-label={d.name}>
          {releases.length > 0 && <a href={`${base}releases/`}>{u.releases}</a>}
          {docLinks.map((l) => <a href={`${base}${l.key}/`}>{l.label}</a>)}
          <a href={`${href(lang, '/feedback/')}?app=${app.id}`}>{u.feedback.nav}</a>
          {d.repo && <a href={d.repo} rel="noopener">GitHub ↗</a>}
        </nav>
      </div>
    </section>
  )}
</Base>

<script>
  // ---------- 图集：画面切换、浅色/深色、自动轮播、指针光晕与倾斜 ----------
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const root = document.documentElement;
  const stage = document.querySelector<HTMLElement>('.stage');
  const full = document.getElementById('stage-full') as HTMLAnchorElement | null;
  const figures = Array.from(document.querySelectorAll<HTMLElement>('.stage-shots figure'));
  const tabs = document.querySelector<HTMLElement>('.stage-tabs');
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.stage-tabs button'));
  const lookButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-look-btn]'));
  let current = 0;

  // 分段控件的滑块：移动到被按下的按钮下方
  const placePill = (group: Element | null, btn: HTMLElement | undefined) => {
    const pill = group?.querySelector<HTMLElement>('.seg-pill');
    if (!pill || !btn) return;
    pill.style.width = `${btn.offsetWidth}px`;
    pill.style.transform = `translateX(${btn.offsetLeft}px)`;
    pill.style.height = `${btn.offsetHeight}px`;
    pill.style.top = `${btn.offsetTop}px`;
  };
  const syncFull = () => {
    if (!full || !stage) return;
    const look = stage.dataset.look === 'dark' ? '.layer-dark' : '.layer-light';
    const img = figures[current]?.querySelector<HTMLImageElement>(look) ?? figures[current]?.querySelector('img');
    if (img?.dataset.full) full.href = img.dataset.full;
  };

  const show = (i: number) => {
    if (i === current || !figures[i]) return;
    figures[i].dataset.seen = 'true';
    // 先让新画面以透明状态参与布局（强制一次样式计算），再切到可见，保证淡入过渡生效
    void figures[i].offsetWidth;
    figures.forEach((f, k) => (k === i ? (f.dataset.active = 'true') : delete f.dataset.active));
    current = i;
    tabButtons.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i)));
    placePill(tabs, tabButtons[i]);
    syncFull();
    // 只横向滚动标签栏让当前项居中；不用 scrollIntoView，以免自动轮播时把整页拽走
    const btn = tabButtons[i];
    if (tabs && btn && tabs.scrollWidth > tabs.clientWidth) {
      tabs.scrollTo({ left: btn.offsetLeft - (tabs.clientWidth - btn.offsetWidth) / 2, behavior: reduce.matches ? 'auto' : 'smooth' });
    }
  };

  // 浅色/深色：默认跟随网站外观；在图集里手动选过后以手动为准，直到网站外观再次变化
  let manualLook: string | null = null;
  const setLook = (look: string) => {
    if (!stage || !stage.dataset.hasDark) return;
    if (look === 'dark') stage.dataset.darkLoaded = 'true';
    stage.dataset.look = look;
    lookButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lookBtn === look)));
    placePill(lookButtons[0]?.parentElement ?? null, lookButtons.find((b) => b.dataset.lookBtn === look));
    syncFull();
  };
  lookButtons.forEach((b) =>
    b.addEventListener('click', () => {
      manualLook = b.dataset.lookBtn ?? 'light';
      setLook(manualLook);
      stopAutoplay();
    }),
  );
  new MutationObserver(() => {
    manualLook = null;
    setLook(root.dataset.theme === 'dark' ? 'dark' : 'light');
  }).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  setLook(root.dataset.theme === 'dark' ? 'dark' : 'light');

  // 自动轮播：进入视口后每 6 秒换一个画面；悬停、聚焦或任何点击后停止
  const interval = 6000;
  let timer = 0;
  let stopped = reduce.matches || figures.length < 2;
  const progress = document.querySelector<HTMLElement>('.seg-progress');
  const restartProgress = () => {
    if (!progress) return;
    progress.style.animation = 'none';
    void progress.offsetWidth;
    progress.style.animation = `seg-progress ${interval}ms linear forwards`;
  };
  const tick = () => {
    show((current + 1) % figures.length);
    restartProgress();
  };
  const startAutoplay = () => {
    if (stopped || timer) return;
    restartProgress();
    timer = window.setInterval(tick, interval);
  };
  const pauseAutoplay = () => {
    window.clearInterval(timer);
    timer = 0;
    if (progress) progress.style.animation = 'none';
  };
  function stopAutoplay() {
    stopped = true;
    pauseAutoplay();
    stage?.classList.add('autoplay-off');
  }
  tabButtons.forEach((b) =>
    b.addEventListener('click', () => {
      stopAutoplay();
      show(Number(b.dataset.target));
    }),
  );
  stage?.addEventListener('pointerenter', pauseAutoplay);
  stage?.addEventListener('pointerleave', startAutoplay);
  stage?.addEventListener('focusin', stopAutoplay);
  tabs?.addEventListener('keydown', (e) => {
    const k = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
    if (!k) return;
    e.preventDefault();
    const next = (current + k + figures.length) % figures.length;
    show(next);
    tabButtons[next]?.focus();
  });
  if (stage && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? startAutoplay() : pauseAutoplay()), { threshold: 0.4 }).observe(stage);
  }

  // 指针光晕与轻微 3D 倾斜（仅精确指针、未开启减少动态效果）
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const shots = document.querySelector<HTMLElement>('.stage-shots');
  if (stage && shots && finePointer.matches && !reduce.matches) {
    let frame = 0;
    stage.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = stage.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height;
        stage.style.setProperty('--mx', `${(x * 100).toFixed(1)}%`);
        stage.style.setProperty('--my', `${(y * 100).toFixed(1)}%`);
        shots.style.setProperty('--rx', `${((0.5 - y) * 4).toFixed(2)}deg`);
        shots.style.setProperty('--ry', `${((x - 0.5) * 6).toFixed(2)}deg`);
      });
    });
    stage.addEventListener('pointerleave', () => {
      shots.style.setProperty('--rx', '0deg');
      shots.style.setProperty('--ry', '0deg');
    });
  }

  const layoutPills = () => {
    placePill(tabs, tabButtons[current]);
    const look = stage?.dataset.look ?? 'light';
    placePill(lookButtons[0]?.parentElement ?? null, lookButtons.find((b) => b.dataset.lookBtn === look));
  };
  layoutPills();
  addEventListener('resize', layoutPills);
  document.fonts?.ready.then(layoutPills);
  requestAnimationFrame(() => stage?.classList.add('pills-ready'));

  // ---------- 滚动浮现：区块进入视口时依次淡入上浮 ----------
  const revealed = document.querySelectorAll<HTMLElement>('[data-reveal]');
  if (!reduce.matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((en) => {
          if (!en.isIntersecting) return;
          en.target.classList.add('is-in');
          io.unobserve(en.target);
        }),
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );
    revealed.forEach((el) => io.observe(el));
  } else {
    revealed.forEach((el) => el.classList.add('is-in'));
  }
</script>

