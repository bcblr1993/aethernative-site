---
import { downloadURL } from '../../../../../lib/download-url';
import Base from '../../../../../layouts/Base.astro';
import AppIcon from '../../../../../components/AppIcon.astro';
import ReleaseMeta from '../../../../../components/ReleaseMeta.astro';
import { getApps, getReleases, latestStable, type App, type Release } from '../../../../../lib/apps';
import { fmtDate, href, langs, t, ui, type Lang } from '../../../../../lib/i18n';

export async function getStaticPaths() {
  const apps = await getApps();
  const out = [];
  for (const app of apps) {
    // 还没有版本的软件也生成此页（显示空状态），详情页与支持页的“版本记录”链接始终有效
    const releases = await getReleases(app.id);
    for (const lang of langs) out.push({ params: { lang: lang === 'zh' ? undefined : lang, slug: app.id }, props: { lang, app, releases } });
  }
  return out;
}

const { lang, app, releases } = Astro.props as { lang: Lang; app: App; releases: Release[] };
const u = ui[lang];
const zh = lang === 'zh';
const base = href(lang, `/apps/${app.id}/`);
const latest = latestStable(releases);
const groups = [
  { id: 'stable', title: zh ? '正式版' : 'Releases', items: releases.filter((r) => r.channel === 'stable') },
  { id: 'beta', title: zh ? '测试版' : 'Beta releases', items: releases.filter((r) => r.channel === 'beta') },
  { id: 'preview', title: zh ? '历史技术预览' : 'Archived previews', items: releases.filter((r) => r.channel === 'preview') },
].filter((g) => g.items.length);

const channelLabel = (r: Release) =>
  r.channel === 'preview' ? u.preview : r.channel === 'beta' ? u.beta : zh ? '正式版' : 'Stable';
const channelClass = (r: Release) =>
  r.channel === 'beta' ? 'soon' : r.channel === 'preview' ? 'gray' : r === latest ? 'ok' : 'gray';
---
<Base lang={lang} title={`${app.data.name} ${u.releases}`} current="apps">
  <div class="wrap releases-page">
    <header class="page-hero">
      <nav class="crumb-nav" aria-label={zh ? '面包屑导航' : 'Breadcrumb'}>
        <a class="crumb-link" href={href(lang, '/#apps')}>{u.nav.apps}</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <a class="crumb-link" href={base}>{app.data.name}</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="crumb-cur" aria-current="page">{u.releases}</span>
      </nav>

      <div class="hero-app">
        <AppIcon app={app} size={56} eager />
        <div class="hero-app-meta">
          <p class="eyebrow">{app.data.name} · {u.releases}</p>
          {releases.length > 0 && (
            <span class="release-count">
              {zh ? `共 ${releases.length} 个版本` : `${releases.length} ${releases.length === 1 ? 'release' : 'releases'}`}
            </span>
          )}
        </div>
      </div>

      <h1>{zh ? <>每一次发布，<br /><span class="grad">都有据可查。</span></> : <>Every release.<br /><span class="grad">Clearly documented.</span></>}</h1>
      <p class="hero-lead">{zh
        ? '正式版、测试版与历史预览版分开列出，提供发布时间、系统要求与 SHA-256 校验和。'
        : 'Stable releases, beta releases and archived previews are listed separately, with dates, requirements and SHA-256 checksums.'}</p>

      {groups.length > 1 && (
        <div class="channel-nav" aria-label={zh ? '版本通道' : 'Release channels'}>
          {groups.map((g) => (
            <a class="channel-pill" href={`#group-${g.id}`}>
              <span>{g.title}</span>
              <span class="channel-n">{g.items.length}</span>
            </a>
          ))}
        </div>
      )}
    </header>

    {!groups.length && (
      <section class="group">
        <div class="card empty-card">
          <div class="empty-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
              <path d="m3.3 7 8.7 5 8.7-5" />
              <path d="M12 22V12" />
            </svg>
          </div>
          <h2>{zh ? '尚未发布版本记录' : 'No releases yet'}</h2>
          <p class="empty-desc">{zh ? '尚未发布正式版本，首个版本发布后会列在这里。' : 'No releases yet. The first release will be listed here.'}</p>
          <a class="btn btn-s btn-sm" href={base}>{u.backTo(app.data.name)}</a>
        </div>
      </section>
    )}

    {groups.map((g) => (
      <section class="group" id={`group-${g.id}`}>
        <div class="group-head">
          <h2>{g.title}</h2>
          <span class="group-count">{g.items.length}</span>
        </div>

        <div class="timeline">
          {g.items.map((r, idx) => {
            const isLatest = r === latest;
            return (
              <div class:list={['tl-row', { 'is-latest': isLatest, 'is-first': idx === 0, 'is-last': idx === g.items.length - 1 }]}>
                <div class="tl-aside">
                  <time class="tl-date" datetime={r.date.toISOString().slice(0, 10)}>{fmtDate(r.date, lang)}</time>
                  <span class:list={['badge', 'tl-channel', channelClass(r)]}>{channelLabel(r)}</span>
                </div>

                <div class="tl-track" aria-hidden="true">
                  <span class="tl-line-top"></span>
                  <span class="tl-dot"></span>
                  <span class="tl-line-bot"></span>
                </div>

                <div class="tl-main">
                  <article class:list={['card', 'rel', { latest: isLatest }]}>
                    <div class="rel-head">
                      <h3>
                        <a href={`${base}releases/${r.version}/`}>
                          <span>{app.data.name}</span>
                          <span class="rel-ver">{r.version}</span>
                        </a>
                      </h3>
                      {(isLatest || r.badge) && (
                        <div class="rel-badges">
                          {isLatest && (
                            <span class="badge ok latest-badge">
                              <span class="live-dot" aria-hidden="true"></span>
                              {u.latest}
                            </span>
                          )}
                          {r.badge && <span class="badge gray">{t(r.badge, lang)}</span>}
                        </div>
                      )}
                    </div>

                    <ReleaseMeta release={r} app={app} lang={lang} showDate={false} />
                    <p class="sum">{t(r.summary, lang)}</p>

                    <div class="acts">
                      {isLatest && r.download && (
                        <a class="btn btn-p btn-sm" href={downloadURL(app.id, r.version)} rel="nofollow">
                          {u.download(r.version)} ↓
                        </a>
                      )}
                      <a class="more detail-link" href={`${base}releases/${r.version}/`}>
                        <span>{u.viewDetails}</span>
                        <span class="arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                  </article>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .releases-page {
    padding-bottom: 72px;
  }

  /* Breadcrumb */
  .crumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 13.5px;
    color: var(--text-3);
  }
  .crumb-link {
    color: var(--text-2);
    transition: color 0.16s var(--ease-out);
  }
  .crumb-link:hover {
    color: var(--text);
  }
  .crumb-sep {
    color: var(--line-strong);
    user-select: none;
  }
  .crumb-cur {
    color: var(--text-3);
  }

  /* Hero */
  .hero-app {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 24px;
  }
  .hero-app-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .release-count {
    font-size: 13px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .page-hero h1 {
    margin-top: 20px;
  }
  .hero-lead {
    color: var(--text-2);
    font-size: 17px;
    max-width: 640px;
    line-height: 1.6;
  }

  .channel-nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .channel-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-2);
    transition: border-color 0.18s var(--ease-out), color 0.18s var(--ease-out), background-color 0.18s var(--ease-out);
  }
  .channel-pill:hover {
    color: var(--text);
    border-color: var(--line-strong);
    background: var(--surface-2);
  }
  .channel-n {
    font-family: var(--mono);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
    color: var(--text-3);
  }

  /* Empty state */
  .empty-card {
    max-width: 540px;
    padding: 40px 32px;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 12px;
    box-shadow: var(--shadow-sm, var(--shadow)), var(--specular, none);
  }
  .empty-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--text-2);
    display: grid;
    place-items: center;
    margin-bottom: 4px;
  }
  .empty-card h2 {
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .empty-desc {
    color: var(--text-2);
    font-size: 15px;
    max-width: 380px;
    margin-bottom: 6px;
  }

  /* Group header */
  .group {
    padding: 20px 0 28px;
  }
  .group + .group {
    border-top: 1px solid var(--line);
    padding-top: 38px;
  }
  .group-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 24px;
  }
  .group-head h2 {
    font-size: 24px;
    letter-spacing: -0.025em;
  }
  .group-count {
    font-family: var(--mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--text-3);
    background: var(--surface-2);
    border: 1px solid var(--line);
    padding: 2px 9px;
    border-radius: 999px;
  }

  /* Linear / Stripe Vertical Timeline */
  .timeline {
    display: grid;
  }
  .tl-row {
    display: grid;
    grid-template-columns: 176px 28px minmax(0, 1fr);
    gap: 0 12px;
    align-items: stretch;
  }
  .tl-aside {
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    text-align: right;
  }
  .tl-date {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .is-latest .tl-date {
    color: var(--text);
    font-weight: 600;
  }
  .tl-channel {
    font-size: 11px;
  }

  .tl-track {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .tl-line-top {
    width: 1px;
    height: 29px;
    background: var(--line);
    flex: none;
  }
  .is-first .tl-line-top {
    background: transparent;
  }
  .tl-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--line-strong);
    flex: none;
  }
  .is-latest .tl-dot {
    background: var(--ok);
    border-color: var(--ok);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 18%, transparent);
  }
  .tl-line-bot {
    width: 1px;
    flex: 1;
    background: var(--line);
  }
  .is-last .tl-line-bot {
    background: linear-gradient(to bottom, var(--line), transparent);
  }

  .tl-main {
    min-width: 0;
    padding-bottom: 18px;
  }
  .is-last .tl-main {
    padding-bottom: 0;
  }

  /* Release Card */
  .rel {
    padding: 24px 28px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm, none), var(--specular, none);
    transition: border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }
  .rel:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow), var(--specular, none);
  }
  .rel.latest {
    border-color: color-mix(in srgb, var(--ok) 34%, var(--line-strong));
    box-shadow: var(--shadow), inset 0 1px 0 color-mix(in srgb, var(--ok) 16%, transparent);
  }
  .rel.latest:hover {
    border-color: color-mix(in srgb, var(--ok) 50%, var(--line-strong));
    box-shadow: var(--shadow-lg, var(--shadow)), inset 0 1px 0 color-mix(in srgb, var(--ok) 22%, transparent);
  }

  .rel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .rel-head h3 {
    font-size: 20px;
    letter-spacing: -0.02em;
    min-width: 0;
  }
  .rel-head h3 a {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    transition: color 0.16s var(--ease-out);
  }
  .rel-head h3 a:hover {
    color: var(--accent);
  }
  .rel-ver {
    font-variant-numeric: tabular-nums;
  }
  .rel-badges {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .latest-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
    flex: none;
  }

  .sum {
    margin-top: 12px;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.62;
  }

  .acts {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 18px;
    flex-wrap: wrap;
  }
  .detail-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .detail-link .arrow {
    transition: transform 0.18s var(--ease-out);
  }
  .detail-link:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 820px) {
    .tl-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .tl-aside {
      padding-top: 0;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      text-align: left;
    }
    .tl-track {
      display: none;
    }
    .tl-main {
      padding-bottom: 16px;
    }
    .rel {
      padding: 20px;
    }
  }
</style>
