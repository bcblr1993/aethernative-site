---
import { getCollection } from 'astro:content';
import AppIcon from '../../components/AppIcon.astro';
import CommunityCard from '../../components/CommunityCard.astro';
import Base from '../../layouts/Base.astro';
import { getApps, getReleases } from '../../lib/apps';
import { href, langParams, site, t, ui, type Lang } from '../../lib/i18n';

export const getStaticPaths = langParams;
const { lang } = Astro.props as { lang: Lang };
const u = ui[lang];
const zh = lang === 'zh';
const apps = await getApps();
// 发布记录页只为有版本的软件生成
const hasReleases = new Set((await Promise.all(apps.map(async (a) => ((await getReleases(a.id)).length ? a.id : null)))).filter(Boolean));
const docIds = new Set((await getCollection('docs')).map((d) => d.id));
const docLinks = [
  { key: 'support', label: u.help },
  { key: 'privacy', label: u.privacy },
  { key: 'license', label: u.license },
];
const countLabel = zh ? `共 ${apps.length} 款软件` : `${apps.length} apps`;
---
<Base lang={lang} title={u.nav.support} current="support">
  <div class="wrap support-wrap">
    <header class="page-hero support-hero">
      <p class="eyebrow">Support</p>
      <h1>{zh ? '需要帮助？' : 'How can we help?'}</h1>
      <p class="lead">
        {zh
          ? '面向 Apple M 系列芯片（M1 及更新）与 macOS 26 及以上系统。选择你使用的软件，查看安装说明、已知问题与版本记录。'
          : 'For Apple M-series Macs running macOS 26 or later. Choose your app for setup guides, known issues, troubleshooting and release notes.'}
      </p>
    </header>

    <CommunityCard lang={lang} />

    <div class="support-toolbar">
      <div class="toolbar-meta">
        <h2>{zh ? '全部软件支持' : 'App support directory'}</h2>
        <span class="support-count" data-support-count data-total={apps.length}>{countLabel}</span>
      </div>
      <div class="search-box">
        <svg class="search-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <input
          type="search"
          data-support-search
          placeholder={zh ? '快速筛选软件名称或简介…' : 'Filter apps by name or tagline…'}
          aria-label={zh ? '筛选软件支持卡片' : 'Filter app support cards'}
          autocomplete="off"
        />
        <button type="button" class="search-clear" data-support-clear hidden aria-label={zh ? '清除搜索' : 'Clear search'}>
          ×
        </button>
      </div>
    </div>

    <div class="grid-2 support-grid" data-support-grid>
      {apps.map((app) => {
        const base = href(lang, `/apps/${app.id}/`);
        const tagline = t(app.data.tagline, lang);
        const searchText = `${app.data.name} ${app.id} ${tagline}`.toLowerCase();
        return (
          <article class="card app" data-support-card data-search={searchText}>
            <div class="head">
              <a class="head-icon" href={base} tabindex="-1" aria-hidden="true">
                <AppIcon app={app} size={52} />
              </a>
              <div class="head-copy">
                <h2>
                  <a href={base}>{app.data.name}</a>
                </h2>
                <p>{tagline}</p>
              </div>
            </div>
            <ul class="app-links">
              {docLinks
                .filter((l) => docIds.has(`${app.id}/${l.key}`))
                .map((l) => (
                  <li>
                    <a href={`${base}${l.key}/`}>
                      <span>{l.label}</span>
                      <span class="arr" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              {hasReleases.has(app.id) && (
                <li>
                  <a href={`${base}releases/`}>
                    <span>{u.releases}</span>
                    <span class="arr" aria-hidden="true">→</span>
                  </a>
                </li>
              )}
              <li>
                <a href={`${base}issues/`}>
                  <span>{zh ? '已知问题' : 'Known issues'}</span>
                  <span class="arr" aria-hidden="true">→</span>
                </a>
              </li>
              <li>
                <a href={`${href(lang, '/feedback/')}?app=${app.id}`}>
                  <span>{u.feedback.nav}</span>
                  <span class="arr" aria-hidden="true">→</span>
                </a>
              </li>
              {app.data.repo && (
                <li>
                  <a href={app.data.repo} target="_blank" rel="noopener noreferrer">
                    <span>GitHub</span>
                    <span class="arr" aria-hidden="true">↗</span>
                  </a>
                </li>
              )}
              {app.data.repo && (
                <li>
                  <a href={`${app.data.repo}/issues`} target="_blank" rel="noopener noreferrer">
                    <span>GitHub Issues</span>
                    <span class="arr" aria-hidden="true">↗</span>
                  </a>
                </li>
              )}
            </ul>
          </article>
        );
      })}
    </div>

    <div class="card support-empty" data-support-empty hidden>
      <p class="empty-title">{zh ? '没有找到匹配的软件' : 'No matching apps found'}</p>
      <p class="empty-desc">{zh ? '尝试更换关键词，或清除筛选查看全部支持入口。' : 'Try another keyword or clear the filter to see all apps.'}</p>
      <button type="button" class="btn btn-s btn-sm" data-support-reset>{zh ? '显示全部软件' : 'Show all apps'}</button>
    </div>

    <section class="contact-sec">
      <div class="contact-head">
        <p class="eyebrow">{zh ? 'Contact' : 'Contact'}</p>
        <h2>{zh ? '联系方式' : 'Contact'}</h2>
      </div>
      <div class="grid-2 contact-grid">
        <article class="card contact-card">
          <div class="contact-ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="11" width="14" height="10" rx="2.5" />
              <path d="M8 11V8a4 4 0 0 1 8 0v3" />
            </svg>
          </div>
          <h3>{zh ? '私密意见反馈' : 'Private feedback'}</h3>
          <p>
            {zh
              ? '使用中遇到问题或有功能建议，可以登录后提交反馈。反馈只有你和开发者能看到，处理进度和回复会显示在反馈页。'
              : 'If something isn’t working or you have an idea, sign in and send feedback. Only you and the developer can see it, and progress and replies appear on the feedback page.'}
          </p>
          <div class="contact-foot">
            <a class="btn btn-p btn-sm" href={href(lang, '/feedback/')}>{u.feedback.title} →</a>
          </div>
        </article>

        <article class="card contact-card">
          <div class="contact-ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              <path d="M12 8v4" />
              <path d="M12 16h.01" />
            </svg>
          </div>
          <h3>{zh ? '公开 Issue 与安全报告' : 'Public issues & security'}</h3>
          <p>
            {zh
              ? '也可以在对应软件的 GitHub 仓库公开提交 Issue，适合可复现的错误、兼容性问题和功能讨论。提交前请勿公开订阅地址、密码、私钥等敏感信息。'
              : 'You can also open a public issue in the app’s GitHub repository — a good fit for reproducible bugs, compatibility issues and feature discussions. Never post subscription URLs, passwords, private keys or other secrets.'}
          </p>
          <p class="security-note">
            {zh
              ? '安全漏洞请按对应仓库 SECURITY.md 中的私密流程报告，不要创建公开 Issue。'
              : 'Report security vulnerabilities privately using the process in each repository’s SECURITY.md — not in a public issue.'}
          </p>
          <div class="contact-foot">
            <a class="btn btn-s btn-sm" href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </div>
        </article>
      </div>
    </section>
  </div>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-support-search]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-support-clear]');
  const resetBtn = document.querySelector<HTMLButtonElement>('[data-support-reset]');
  const countEl = document.querySelector<HTMLElement>('[data-support-count]');
  const emptyEl = document.querySelector<HTMLElement>('[data-support-empty]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-support-card]')];

  if (input && countEl && emptyEl) {
    const zh = document.documentElement.lang.startsWith('zh');
    const total = Number(countEl.dataset.total ?? cards.length);

    const applyFilter = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const match = !q || (card.dataset.search ?? '').includes(q);
        card.hidden = !match;
        if (match) shown++;
      }
      if (clearBtn) clearBtn.hidden = !q;
      emptyEl.hidden = shown > 0;
      countEl.textContent = q
        ? zh
          ? `找到 ${shown} / ${total} 款`
          : `${shown} of ${total}`
        : zh
          ? `共 ${total} 款软件`
          : `${total} apps`;
    };

    input.addEventListener('input', applyFilter);
    clearBtn?.addEventListener('click', () => {
      input.value = '';
      applyFilter();
      input.focus();
    });
    resetBtn?.addEventListener('click', () => {
      input.value = '';
      applyFilter();
      input.focus();
    });
  }
</script>

<style>
  .support-wrap {
    padding-bottom: 88px;
  }
  .support-hero {
    padding-bottom: 32px;
  }
  .support-hero .lead {
    margin-top: 8px;
  }

  .support-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .toolbar-meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .toolbar-meta h2 {
    font-size: 20px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .support-count {
    font-size: 13px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .search-box {
    position: relative;
    flex: 1 1 260px;
    max-width: 340px;
  }
  .search-ic {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: var(--text-3);
    pointer-events: none;
  }
  .search-box input {
    width: 100%;
    height: 40px;
    padding: 0 36px 0 38px;
    border-radius: 999px;
    border: 1px solid var(--line-strong, var(--line));
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 14px;
    box-shadow: var(--shadow-sm, none);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .search-box input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .search-box input::placeholder {
    color: var(--text-3);
  }
  .search-box input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .search-clear {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    border: 0;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--text-2);
    font-size: 16px;
    line-height: 1;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .search-clear:hover {
    color: var(--text);
    background: var(--surface-3, var(--surface-2));
  }

  .support-grid {
    gap: 18px;
  }
  .app {
    display: grid;
    gap: 16px;
    align-content: start;
    padding: 24px;
    transition: border-color 0.2s var(--ease-out, ease);
  }
  .app:hover {
    border-color: var(--line-strong, var(--line));
  }
  .head {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .head-icon {
    flex: none;
    display: inline-flex;
    border-radius: 14px;
  }
  .head-copy {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .head h2 {
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  .head h2 a:hover {
    color: var(--accent);
  }
  .head p {
    font-size: 13.5px;
    line-height: 1.45;
    margin-top: 3px;
    color: var(--text-2);
  }

  .app-links {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .app-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 11px;
    border-radius: 10px;
    background: var(--surface-2);
    border: 1px solid transparent;
    color: var(--text);
    font-size: 13.5px;
    font-weight: 500;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .app-links a .arr {
    color: var(--text-3);
    font-size: 13px;
    transition: transform 0.15s var(--ease-out, ease), color 0.15s;
  }
  .app-links a:hover {
    border-color: var(--line-strong, var(--line));
    background: var(--surface);
    color: var(--accent);
  }
  .app-links a:hover .arr {
    color: var(--accent);
    transform: translateX(2px);
  }

  .support-empty {
    display: grid;
    justify-items: center;
    gap: 8px;
    text-align: center;
    padding: 44px 24px;
    margin-top: 8px;
  }
  .empty-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--text);
  }
  .empty-desc {
    font-size: 14px;
    color: var(--text-2);
    margin-bottom: 6px;
  }

  .contact-sec {
    padding: 64px 0 0;
  }
  .contact-head {
    margin-bottom: 20px;
  }
  .contact-head h2 {
    margin-top: 6px;
    font-size: clamp(26px, 3.6vw, 34px);
    letter-spacing: -0.025em;
  }
  .contact-grid {
    gap: 18px;
  }
  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
  }
  .contact-ic {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--accent);
    margin-bottom: 2px;
  }
  .contact-ic svg {
    width: 20px;
    height: 20px;
  }
  .contact-card h3 {
    font-size: 19px;
    font-weight: 650;
  }
  .contact-card p {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-2);
  }
  .contact-card .security-note {
    padding: 12px 14px;
    border-radius: var(--radius-sm, 12px);
    background: var(--surface-2);
    border: 1px solid var(--line);
    font-size: 13.5px;
    color: var(--text);
  }
  .contact-foot {
    margin-top: auto;
    padding-top: 8px;
  }

  @media (max-width: 640px) {
    .support-wrap {
      padding-bottom: 64px;
    }
    .search-box {
      max-width: none;
      width: 100%;
    }
    .app {
      padding: 20px;
    }
    .app-links {
      grid-template-columns: 1fr 1fr;
      gap: 6px;
    }
    .app-links a {
      padding: 8px 10px;
      font-size: 13px;
    }
    .contact-sec {
      padding-top: 48px;
    }
    .contact-card {
      padding: 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .app-links a:hover .arr {
      transform: none;
    }
  }
</style>
