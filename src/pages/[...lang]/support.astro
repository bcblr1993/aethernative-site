---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getApps, getReleases } from '../../lib/apps';
import { href, langParams, t, ui, type Lang } from '../../lib/i18n';

export const getStaticPaths = langParams;
const { lang } = Astro.props as { lang: Lang };
const u = ui[lang];
const zh = lang === 'zh';
const apps = await getApps();
// 发布记录页只为有版本的软件生成
const hasReleases = new Set((await Promise.all(apps.map(async (a) => ((await getReleases(a.id)).length ? a.id : null)))).filter(Boolean));
const docIds = new Set((await getCollection('docs')).map((d) => d.id));
const docLinks = [
  { key: 'support', label: u.help },
  { key: 'privacy', label: u.privacy },
  { key: 'license', label: u.license },
];
---
<Base lang={lang} title={u.nav.support} current="support">
  <div class="wrap">
    <header class="page-hero">
      <p class="eyebrow">Support</p>
      <h1>{zh ? '需要帮助？' : 'How can we help?'}</h1>
      <p>{zh ? '选择你使用的软件，查看安装说明、常见问题与版本记录。' : 'Choose your app for setup guides, troubleshooting and release notes.'}</p>
    </header>

    <div class="grid-2">
      {apps.map((app) => {
        const base = href(lang, `/apps/${app.id}/`);
        return (
          <article class="card app">
            <div class="head">
              <div class="icon"><Image src={app.data.icon} alt="" width={96} height={96} /></div>
              <div><h2>{app.data.name}</h2><p>{t(app.data.tagline, lang)}</p></div>
            </div>
            <ul>
              {docLinks.filter((l) => docIds.has(`${app.id}/${l.key}`)).map((l) => <li><a href={`${base}${l.key}/`}>{l.label} →</a></li>)}
              {hasReleases.has(app.id) && <li><a href={`${base}releases/`}>{u.releases} →</a></li>}
              <li><a href={`${href(lang, '/feedback/')}?app=${app.id}`}>{u.feedback.nav} →</a></li>
              {app.data.repo && <li><a href={`${app.data.repo}/issues`} rel="noopener">GitHub Issues ↗</a></li>}
            </ul>
          </article>
        );
      })}
    </div>

    <section class="prose contact">
      <h2>{zh ? '联系方式' : 'Contact'}</h2>
      <p>{zh
        ? '使用中遇到问题或有功能建议，可以登录后提交反馈。反馈只有你和开发者能看到，处理进度和回复会显示在反馈页。'
        : 'If something isn’t working or you have an idea, sign in and send feedback. Only you and the developer can see it, and progress and replies appear on the feedback page.'}</p>
      <p><a class="btn btn-p btn-sm" href={href(lang, '/feedback/')}>{u.feedback.title} →</a></p>
      <p>{zh
        ? '也可以在对应软件的 GitHub 仓库公开提交 Issue，适合可复现的错误、兼容性问题和功能讨论。提交前请勿公开订阅地址、密码、私钥等敏感信息。'
        : 'You can also open a public issue in the app’s GitHub repository — a good fit for reproducible bugs, compatibility issues and feature discussions. Never post subscription URLs, passwords, private keys or other secrets.'}</p>
      <p>{zh
        ? '安全漏洞请按对应仓库 SECURITY.md 中的私密流程报告，不要创建公开 Issue。'
        : 'Report security vulnerabilities privately using the process in each repository’s SECURITY.md — not in a public issue.'}</p>
    </section>
  </div>
</Base>

<style>
  .app { display: grid; gap: 18px; }
  .head { display: flex; gap: 16px; align-items: center; }
  .icon { width: 64px; height: 64px; flex: none; margin: -4px; }
  .head h2 { font-size: 22px; }
  .head p { font-size: 14px; }
  ul { list-style: none; display: grid; gap: 2px; border-top: 1px solid var(--line); padding-top: 12px; }
  ul a { display: block; padding: 8px 0; color: var(--accent); font-size: 15px; }
  ul a:hover { text-decoration: underline; }
  .contact { padding: 60px 0 0; }
</style>
