---
import Base from '../../layouts/Base.astro';
import { href, langParams, site, t, ui, type Lang } from '../../lib/i18n';

export const getStaticPaths = langParams;
const { lang } = Astro.props as { lang: Lang };
const zh = lang === 'zh';

const pillars = zh
  ? ['Apple M 系列芯片 (arm64)', 'macOS 26 及以上系统', 'SwiftUI & AppKit 原生', '统一内存与能效核心调度']
  : ['Apple M-Series (arm64)', 'macOS 26 or later', 'SwiftUI & AppKit', 'Unified Memory & E-Core'];

const promises = [
  {
    num: '01',
    title: zh ? '性能数据实测公开' : 'Measured performance',
    body: zh
      ? '性能数据实测公开，并写明测试条件，不只靠形容词。'
      : 'Performance is measured and published with test conditions — not just adjectives.',
    icon: '<path d="M12 14l4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/><path d="M7 19h10"/>',
  },
  {
    num: '02',
    title: zh ? '零追踪隐私保护' : 'Private by default',
    body: zh
      ? '不接入广告和第三方行为分析，数据默认留在你的设备上。'
      : 'No ads or third-party behavioral analytics. Your data stays on your device by default.',
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    num: '03',
    title: zh ? 'Apple 公证与 SHA-256' : 'Apple notarized & verified',
    body: zh
      ? '每个安装包都经过 Apple 公证，并提供 SHA-256 校验值。'
      : 'Every installer is notarized by Apple and published with a SHA-256 checksum.',
    icon: '<rect x="5" y="11" width="14" height="10" rx="2.5"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><circle cx="12" cy="16" r="1"/>',
  },
  {
    num: '04',
    title: zh ? '完整历史归档' : 'Full release archive',
    body: zh
      ? '更新记录完整保留，历史版本随时可查。'
      : 'Full release history, with previous versions always documented.',
    icon: '<rect x="3" y="4" width="18" height="4" rx="1.5"/><path d="M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/>',
  },
];
---
<Base lang={lang} title={ui[lang].nav.about} current="about">
  <div class="wrap about-wrap">
    <header class="page-hero about-hero">
      <p class="eyebrow">About</p>
      <h1>
        {zh ? (
          <>一个人，<br /><span class="grad">认真做原生软件。</span></>
        ) : (
          <>One developer.<br /><span class="grad">Serious about native.</span></>
        )}
      </h1>
      <p class="lead">
        {zh
          ? `${site.name} 是${t(site.author, lang)}的独立软件品牌，专注为 Apple M 系列芯片与 macOS 26 及以上系统打造原生 Mac 软件。`
          : `${site.name} is the independent software label of ${t(site.author, lang)}, focused on native Mac apps for Apple M-series chips and macOS 26 or later.`}
      </p>
      <div class="studio-tags" aria-label={zh ? '工作室定位' : 'Studio focus'}>
        <span class="chip"><b></b>{zh ? 'Apple M 系列芯片 · macOS 26+' : 'Apple M-Series · macOS 26+'}</span>
        <span class="studio-tag">{zh ? '独立开发 · 原生 macOS' : 'Independent · Native macOS'}</span>
        <span class="studio-tag">{zh ? '零广告 · 零遥测' : 'Zero Ads · Zero Telemetry'}</span>
      </div>
    </header>

    <section class="about-sec">
      <div class="card philosophy-card">
        <div class="philosophy-main">
          <span class="sec-kicker">{zh ? '开发理念' : 'Philosophy'}</span>
          <h2>{zh ? '为什么是“原生”' : 'Why “native”'}</h2>
          <p>
            {zh
              ? '很多软件能在 M 芯片上运行，但并不是为它设计的：套一层网页外壳、在后台不停唤醒、占用几百兆内存。我更想做的是反过来——从 arm64 编译、SwiftUI / AppKit 界面，到统一内存和能效核心调度，每一层都按 Apple 芯片的特性来写。'
              : 'Plenty of software runs on Apple silicon without being designed for it: web wrappers, constant background wake-ups, hundreds of megabytes of memory. I want to do the opposite — from arm64 builds and SwiftUI/AppKit interfaces to unified memory and efficiency-core scheduling, every layer is written for how Apple silicon works.'}
          </p>
        </div>
        <aside class="philosophy-specs" aria-label={zh ? '技术栈特征' : 'Architecture layers'}>
          <span class="specs-label">{zh ? '原生技术栈' : 'Native stack'}</span>
          <ul>
            {pillars.map((item, idx) => (
              <li>
                <span class="spec-idx">{String(idx + 1).padStart(2, '0')}</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </section>

    <section class="about-sec">
      <div class="about-head">
        <div>
          <span class="sec-kicker">{zh ? '核心准则' : 'Principles'}</span>
          <h2>{zh ? '我的承诺' : 'What you can expect'}</h2>
        </div>
      </div>
      <div class="grid-2 bento-grid">
        {promises.map((item) => (
          <article class="card bento-card">
            <div class="bento-top">
              <span class="bento-ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
              </span>
              <span class="bento-num">{item.num}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="about-sec">
      <div class="card contact-card">
        <div class="contact-copy">
          <span class="sec-kicker">{zh ? '联系与交流' : 'Connect'}</span>
          <h2>{zh ? '联系我' : 'Get in touch'}</h2>
          <p>
            {zh
              ? '问题反馈和功能建议，欢迎在对应软件的 GitHub 仓库提交 Issue，或通过网站提交仅开发者可见的私密反馈。'
              : 'For bug reports and feature requests, please open an issue in the app’s GitHub repository or send private feedback on the website.'}
          </p>
        </div>
        <div class="contact-actions">
          <a class="btn btn-p btn-sm" href={href(lang, '/support/')}>{zh ? '支持与帮助 →' : 'Support & help →'}</a>
          <a class="btn btn-s btn-sm" href={href(lang, '/feedback/')}>{ui[lang].feedback.title} →</a>
          <a class="btn btn-s btn-sm" href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .about-wrap {
    padding-bottom: 88px;
  }
  .about-hero {
    padding-bottom: 36px;
  }
  .about-hero .lead {
    margin-top: 10px;
  }
  .studio-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
  }
  .studio-tag {
    display: inline-flex;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    font-size: 13px;
    color: var(--text-2);
  }

  .about-sec {
    padding: 0;
    margin-top: 40px;
  }
  .sec-kicker {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .about-head {
    margin-bottom: 20px;
  }
  .about-head h2 {
    font-size: clamp(24px, 3.2vw, 32px);
    letter-spacing: -0.025em;
  }

  .philosophy-card {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(240px, 0.9fr);
    gap: 32px;
    padding: 36px;
    align-items: start;
  }
  .philosophy-main h2 {
    font-size: clamp(24px, 3vw, 30px);
    letter-spacing: -0.025em;
    margin-bottom: 14px;
  }
  .philosophy-main p {
    font-size: 16px;
    line-height: 1.75;
    color: var(--text-2);
  }
  .philosophy-specs {
    padding: 20px 22px;
    border-radius: var(--radius-sm, 12px);
    background: var(--surface-2);
    border: 1px solid var(--line);
  }
  .specs-label {
    display: block;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 12px;
  }
  .philosophy-specs ul {
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .philosophy-specs li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }
  .philosophy-specs li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .spec-idx {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }

  .bento-grid {
    gap: 18px;
  }
  .bento-card {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 28px;
    transition: border-color 0.2s var(--ease-out, ease), transform 0.2s var(--ease-out, ease);
  }
  .bento-card:hover {
    border-color: var(--line-strong, var(--line));
    transform: translateY(-2px);
  }
  .bento-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }
  .bento-ic {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--accent);
  }
  .bento-ic svg {
    width: 20px;
    height: 20px;
  }
  .bento-num {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .bento-card h3 {
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.015em;
  }
  .bento-card p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-2);
  }

  .contact-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
    padding: 32px 36px;
  }
  .contact-copy {
    flex: 1 1 360px;
    max-width: 560px;
  }
  .contact-copy h2 {
    font-size: clamp(22px, 2.8vw, 28px);
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }
  .contact-copy p {
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-2);
  }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  @media (max-width: 820px) {
    .philosophy-card {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 26px;
    }
    .contact-card {
      padding: 26px;
    }
  }
  @media (max-width: 640px) {
    .about-wrap {
      padding-bottom: 64px;
    }
    .about-sec {
      margin-top: 28px;
    }
    .philosophy-card,
    .bento-card,
    .contact-card {
      padding: 22px;
    }
    .contact-actions {
      width: 100%;
    }
    .contact-actions .btn {
      flex: 1 1 auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bento-card:hover {
      transform: none;
    }
  }
</style>
