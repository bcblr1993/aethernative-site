---
import Base from '../../layouts/Base.astro';
import AppCard from '../../components/AppCard.astro';
import AppIcon from '../../components/AppIcon.astro';
import { Image } from 'astro:assets';
import { getApps, getRecentReleases, getReleases } from '../../lib/apps';
import { fmtDate, href, langParams, t, ui, type Lang } from '../../lib/i18n';

export const getStaticPaths = langParams;
const { lang } = Astro.props as { lang: Lang };
const u = ui[lang];
const zh = lang === 'zh';

const apps = await getApps();
const cards = await Promise.all(apps.map(async (app) => ({ app, releases: await getReleases(app.id) })));
const recent = await getRecentReleases(5);
const featured = cards.find(({ app }) => app.data.featured && app.data.gallery[0]) ?? cards.find(({ app }) => app.data.gallery[0]);
const dockApps = cards.slice(0, 8).map(({ app }) => app);
const heroShot = featured?.app.data.gallery[0];
const heroLight = heroShot ? (lang === 'en' && heroShot.en ? heroShot.en : heroShot.zh) : undefined;
const heroDark = heroShot?.zhDark ? (lang === 'en' && heroShot.enDark ? heroShot.enDark : heroShot.zhDark) : undefined;

type AppCategory = 'network' | 'dev' | 'system' | 'media';
const appCategoryMap: Record<string, AppCategory> = {
  aetherroute: 'network',
  aetherscreens: 'network',
  aethertransfer: 'network',
  aetherterm: 'dev',
  'antigravity-multiplexer': 'dev',
  notchquota: 'dev',
  aetherswitch: 'dev',
  aetherdisk: 'system',
  aetherguard: 'system',
  aetherkey: 'system',
  aetherzip: 'system',
  aetherfilm: 'media',
  aethernote: 'media',
};
const getCategory = (id: string): AppCategory => appCategoryMap[id] ?? 'system';

const categories = [
  { id: 'all', label: zh ? '全部' : 'All' },
  { id: 'network', label: zh ? '网络与远程' : 'Network & Remote' },
  { id: 'dev', label: zh ? '开发与效率' : 'Dev & Productivity' },
  { id: 'system', label: zh ? '系统与安全' : 'System & Security' },
  { id: 'media', label: zh ? '媒体与记录' : 'Media & Notes' },
] as const;

const stats = [
  { v: '100%', l: zh ? 'arm64 原生' : 'Native arm64' },
  { v: '0', l: zh ? 'Electron / 网页壳' : 'Electron / web wrappers' },
  { v: '~0.1%', l: zh ? '后台静默 CPU*' : 'Background idle CPU*' },
  { v: `${apps.length}`, l: zh ? '款正式发布应用' : 'Released Mac apps' },
];

const principles = zh
  ? [
      ['原生到底', 'arm64 原生编译，SwiftUI / AppKit 界面，不套网页壳，启动即用。'],
      ['能效优先', '按需刷新、后台静默、批量处理。性能数据实测公开，不靠形容词。'],
      ['隐私默认', '数据留在本地，同步经端到端加密。不做追踪，不收集不必要的信息。'],
      ['持续打磨', '只展示已有正式版本的产品，并持续提供签名更新与清晰的版本记录。'],
    ]
  : [
      ['Native all the way', 'Compiled for arm64 with SwiftUI and AppKit. No web wrappers — ready the moment you open it.'],
      ['Efficiency first', 'On-demand updates, quiet backgrounds, batched work. Performance is measured and published, not just described.'],
      ['Private by default', 'Your data stays on device and sync is end-to-end encrypted. No tracking, nothing unnecessary collected.'],
      ['Actively refined', 'Only formally released products are listed, with signed updates and a clear release history.'],
    ];

const icons = [
  '<rect x="5" y="5" width="14" height="14" rx="2"/><path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4"/>',
  '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/>',
  '<rect x="2" y="4" width="13" height="10" rx="2"/><rect x="16" y="8" width="6" height="12" rx="1.5"/>',
];

const siliconSpecs = zh
  ? [
      { k: 'ARCH', l: '指令架构', v: 'ARM64 Native Mach-O' },
      { k: 'UI LAYER', l: '界面框架', v: 'SwiftUI & AppKit' },
      { k: 'MEMORY', l: '内存模型', v: 'Unified Memory Zero-Copy' },
      { k: 'POWER', l: '能效调度', v: 'E-Core Idle Scheduling' },
    ]
  : [
      { k: 'ARCH', l: 'Architecture', v: 'ARM64 Native Mach-O' },
      { k: 'UI LAYER', l: 'Interface', v: 'SwiftUI & AppKit' },
      { k: 'MEMORY', l: 'Memory Model', v: 'Unified Memory Zero-Copy' },
      { k: 'POWER', l: 'Scheduling', v: 'E-Core Idle Scheduling' },
    ];
---
<Base lang={lang}>
  <header class="hero">
    <div class="hero-ambient" aria-hidden="true"></div>
    <div class="wrap hero-center">
      <span class="chip"><b></b>{zh ? 'Apple Silicon 原生独立工作室' : 'Independent Apple Silicon Studio'}</span>
      <h1>
        {zh
          ? <>让 Mac 更轻，<br /><span class="grad">也更强。</span></>
          : <>A lighter, faster<br /><span class="grad">way to use your Mac.</span></>}
      </h1>
      <p class="lead">
        {zh
          ? '一系列真正原生的 Mac 工具。没有网页壳，没有臃肿后台——只把性能、电量和注意力，用在真正重要的地方。'
          : 'A growing family of truly native Mac tools. No web wrappers or bloated background work — just thoughtful software that respects your performance, battery, and focus.'}
      </p>
      <div class="cta">
        <a class="btn btn-p" href="#apps">{zh ? `探索 ${apps.length} 款应用` : `Explore ${apps.length} apps`} <span aria-hidden="true">↓</span></a>
        <a class="btn btn-s" href="#why">{zh ? '为什么坚持原生' : 'Why native matters'} <span aria-hidden="true">→</span></a>
      </div>
      <ul class="hero-notes" aria-label={zh ? '产品特点' : 'Product qualities'}>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span>{zh ? 'Apple 公证签名' : 'Apple notarized'}</span>
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span>{zh ? '零 Electron 网页壳' : 'Zero Electron wrappers'}</span>
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span>{zh ? '本地隐私优先' : 'Local-first privacy'}</span>
        </li>
      </ul>
    </div>

    <div class="wrap stage-wrap">
      {featured && heroLight && (
        <div class="studio-window" aria-label={zh ? `${featured.app.data.name} 应用预览` : `${featured.app.data.name} app preview`}>
          <div class="studio-bar">
            <div class="studio-dots" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="studio-title">
              <AppIcon app={featured.app} size={18} eager />
              <span>{featured.app.data.name}</span>
            </div>
            <a class="studio-link" href={href(lang, `/apps/${featured.app.id}/`)}>
              {zh ? '查看应用' : 'View app'} <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class:list={['studio-screen', { 'stage-has-dark': Boolean(heroDark) }]}>
            <Image
              class="stage-img stage-light"
              src={heroLight}
              alt={zh ? `${featured.app.data.name} 应用界面` : `${featured.app.data.name} interface`}
              widths={[720, 1120, 1600]}
              sizes="(max-width: 960px) calc(100vw - 32px), 980px"
              quality={86}
              loading="eager"
            />
            {heroDark && (
              <Image
                class="stage-img stage-dark"
                src={heroDark}
                alt={zh ? `${featured.app.data.name} 深色界面` : `${featured.app.data.name} dark interface`}
                widths={[720, 1120, 1600]}
                sizes="(max-width: 960px) calc(100vw - 32px), 980px"
                quality={86}
                loading="eager"
              />
            )}
          </div>
        </div>
      )}

      {dockApps.length > 0 && (
        <nav class="app-dock" aria-label={zh ? '应用快速导览' : 'Quick app dock'}>
          {dockApps.map((app) => (
            <a
              class:list={['dock-item', { 'is-active': featured?.app.id === app.id }]}
              href={href(lang, `/apps/${app.id}/`)}
              aria-label={app.data.name}
            >
              <AppIcon app={app} size={44} eager />
              <span class="dock-tip" aria-hidden="true">{app.data.name}</span>
            </a>
          ))}
        </nav>
      )}
    </div>

    <div class="wrap center">
      <div class="stats">
        {stats.map((s) => (
          <div class="stat">
            <strong>{s.v}</strong>
            <span>{s.l}</span>
          </div>
        ))}
      </div>
      <p class="foot muted">{u.benchmarkNote}</p>
    </div>
  </header>

  <section id="apps">
    <div class="wrap">
      <div class="sec-head apps-head">
        <div>
          <div class="eyebrow">Apps</div>
          <h2>{zh ? '软件作品' : 'Our apps'}</h2>
        </div>
      </div>

      <div class="apps-toolbar">
        <div class="cat-tabs" role="group" aria-label={zh ? '按分类筛选应用' : 'Filter apps by category'}>
          {categories.map((c) => (
            <button
              type="button"
              class="cat-tab"
              data-category-filter={c.id}
              aria-pressed={c.id === 'all' ? 'true' : 'false'}
            >
              {c.label}
            </button>
          ))}
        </div>

        <label class="app-search">
          <span class="sr-only">{zh ? '搜索应用' : 'Search apps'}</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.2-3.2"></path></svg>
          <input type="search" data-app-search placeholder={zh ? '搜索应用名称或功能…' : 'Search apps or features…'} autocomplete="off" />
        </label>
      </div>

      <div class="grid-3 apps-grid">
        {cards.map(({ app, releases }) => (
          <AppCard app={app} releases={releases} lang={lang} category={getCategory(app.id)} />
        ))}
      </div>

      <div class="empty-apps card" data-empty-apps hidden>
        <strong>{zh ? '没有找到匹配的应用' : 'No matching apps'}</strong>
        <span>{zh ? '试试更短的关键词，或切换分类筛选。' : 'Try a shorter search or switch to another category.'}</span>
        <button type="button" class="btn btn-s btn-sm empty-reset" data-reset-filters>
          {zh ? '显示全部应用' : 'Show all apps'}
        </button>
      </div>

      <p class="results-count muted" data-results-count aria-live="polite"></p>
      <p class="download-note muted">{zh ? '下载量为本站自开始统计以来各正式版本的累计下载发起次数，不代表安装人数。' : 'Totals count download requests through this site across released versions; counts are not unique installs.'}</p>
      <p class="soon muted">{u.moreSoon}</p>
    </div>
  </section>

  <section id="why">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <div class="eyebrow">Philosophy</div>
          <h2>{zh ? <>每一款软件，<br />都守同样的准则。</> : <>Every app.<br />The same principles.</>}</h2>
        </div>
      </div>

      <div class="grid-4 principles-grid">
        {principles.map(([title, body], i) => (
          <div class="card pcard">
            <div class="pcard-head">
              <div class="pico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} /></div>
              <div class="pnum">0{i + 1}</div>
            </div>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        ))}
      </div>

      <div class="silicon">
        <div class="silicon-copy">
          <div class="eyebrow silicon-eyebrow">Apple Silicon Architecture</div>
          <h3>{zh ? <>不是“能在 M 芯片上跑”，<br />而是“为 M 芯片而写”。</> : <>Not just “runs on Apple silicon.”<br />Written for it.</>}</h3>
          <p>
            {zh
              ? '从统一内存到能效核心调度，每款软件都会针对 Apple 芯片的架构特性单独调优，并附上可复现的测试条件。'
              : 'From unified memory to efficiency-core scheduling, every app is tuned for the architecture of Apple silicon — with reproducible test conditions published alongside.'}
          </p>
        </div>

        <div class="silicon-specs" aria-label={zh ? 'Apple Silicon 技术规格' : 'Apple Silicon technical stack'}>
          {siliconSpecs.map((spec) => (
            <div class="spec-row">
              <div class="spec-key">
                <span class="spec-tag">{spec.k}</span>
                <span class="spec-label">{spec.l}</span>
              </div>
              <code class="spec-val">{spec.v}</code>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="updates" class="updates-sec">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <div class="eyebrow">Changelog</div>
          <h2>{zh ? '最近更新' : 'Recent updates'}</h2>
        </div>
        <a class="more" href={href(lang, '/news/')}>{u.news.all} →</a>
      </div>

      <div class="updates card">
        {recent.map(({ app, release }) => (
          <a class="up" href={href(lang, `/apps/${app.id}/releases/${release.version}/`)}>
            <div class="up-id">
              <AppIcon app={app} size={36} />
              <div class="up-title">
                <span class="up-name">{app.data.name}</span>
                <span class="up-ver">{release.version.startsWith('v') ? release.version : `v${release.version}`}</span>
              </div>
            </div>
            <p class="up-summary">{t(release.summary, lang)}</p>
            <div class="up-tail">
              <time datetime={release.date.toISOString().slice(0, 10)}>{fmtDate(release.date, lang)}</time>
              <span class="up-arrow" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const categoryButtons = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
  const platformTabs = document.querySelectorAll<HTMLButtonElement>('.tab[data-filter]');
  const search = document.querySelector<HTMLInputElement>('[data-app-search]');
  const cards = [...document.querySelectorAll<HTMLElement>('.apps-grid [data-platforms]')];
  const empty = document.querySelector<HTMLElement>('[data-empty-apps]');
  const count = document.querySelector<HTMLElement>('[data-results-count]');
  const resetBtn = document.querySelector<HTMLButtonElement>('[data-reset-filters]');

  let activeCategory = 'all';
  let activePlatform = 'all';

  const updateApps = () => {
    const query = search?.value.trim().toLocaleLowerCase(document.documentElement.lang) ?? '';
    let visible = 0;
    for (const card of cards) {
      const categoryMatch = activeCategory === 'all' || card.dataset.category === activeCategory;
      const platformMatch = activePlatform === 'all' || card.dataset.platforms?.split(' ').includes(activePlatform);
      const searchMatch = !query || card.dataset.search?.includes(query);
      card.hidden = !categoryMatch || !platformMatch || !searchMatch;
      if (!card.hidden) visible++;
    }
    if (empty) empty.hidden = visible !== 0;
    if (count) {
      count.textContent = document.documentElement.lang.startsWith('zh')
        ? `显示 ${visible} / ${cards.length} 款应用`
        : `Showing ${visible} of ${cards.length} apps`;
    }
  };

  categoryButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      activeCategory = btn.dataset.categoryFilter ?? 'all';
      categoryButtons.forEach((x) => x.setAttribute('aria-pressed', String(x === btn)));
      updateApps();
    }),
  );

  platformTabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      activePlatform = tab.dataset.filter ?? 'all';
      platformTabs.forEach((x) => x.setAttribute('aria-pressed', String(x === tab)));
      updateApps();
    }),
  );

  resetBtn?.addEventListener('click', () => {
    activeCategory = 'all';
    activePlatform = 'all';
    if (search) search.value = '';
    categoryButtons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.categoryFilter === 'all')));
    platformTabs.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.filter === 'all')));
    updateApps();
    search?.focus();
  });

  search?.addEventListener('input', updateApps);
  updateApps();
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding: 84px 0 48px;
    position: relative;
    overflow-x: clip;
  }
  .hero-ambient {
    position: absolute;
    inset: 0 0 auto;
    height: 520px;
    background: radial-gradient(65% 75% at 50% 0%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 72%);
    pointer-events: none;
    z-index: -1;
  }
  .hero-center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-center h1 {
    margin: 22px 0 20px;
    font-size: clamp(42px, 6.4vw, 76px);
    line-height: 1.06;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .hero-center .lead {
    max-width: 610px;
    margin-inline: auto;
    text-wrap: pretty;
  }
  .hero-center .cta {
    justify-content: center;
    margin-top: 28px;
  }
  .hero-center .btn span {
    transition: transform 0.2s var(--ease-out);
  }
  .hero-center .btn-p:hover span {
    transform: translateY(2px);
  }
  .hero-center .btn-s:hover span {
    transform: translateX(2px);
  }
  .hero-notes {
    list-style: none;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px 24px;
    flex-wrap: wrap;
    margin-top: 24px;
    color: var(--text-3);
    font-size: 13px;
  }
  .hero-notes li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero-notes svg {
    color: var(--ok);
    flex: none;
  }

  /* ---------- Studio Window Stage & App Dock ---------- */
  .stage-wrap {
    margin-top: 52px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .studio-window {
    width: 100%;
    max-width: 980px;
    border-radius: 18px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    box-shadow: var(--shadow-lg), var(--specular);
  }
  .studio-bar {
    height: 40px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 14px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
    gap: 12px;
  }
  .studio-dots {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .studio-dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f57;
    box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.14);
  }
  .studio-dots i:nth-child(2) {
    background: #febc2e;
  }
  .studio-dots i:nth-child(3) {
    background: #28c840;
  }
  .studio-title {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    font-weight: 550;
    color: var(--text-2);
    white-space: nowrap;
  }
  .studio-link {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12.5px;
    font-weight: 550;
    color: var(--accent);
    white-space: nowrap;
    padding: 4px 10px;
    border-radius: 999px;
    transition: background-color 0.2s var(--ease-out);
  }
  .studio-link:hover {
    background: var(--accent-soft);
  }
  .studio-screen {
    background: var(--bg-alt);
  }
  .stage-img {
    width: 100%;
    height: auto;
    display: block;
  }
  .stage-dark {
    display: none;
  }
  :global(:root[data-theme='dark']) .stage-has-dark .stage-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .stage-has-dark .stage-dark {
    display: block;
  }

  /* Interactive macOS App Dock Strip */
  .app-dock {
    margin-top: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 10px 14px;
    max-width: 100%;
    flex-wrap: wrap;
    background: var(--glass);
    backdrop-filter: saturate(180%) blur(22px);
    -webkit-backdrop-filter: saturate(180%) blur(22px);
    border: 1px solid var(--line-strong);
    border-radius: 22px;
    box-shadow: var(--shadow), var(--specular);
  }
  .dock-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
    border-radius: 12px;
    transition: transform 0.24s var(--ease-spring, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .dock-item:hover,
  .dock-item:focus-visible {
    transform: translateY(-5px) scale(1.16);
    z-index: 2;
  }
  .dock-item.is-active::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text-2);
    transform: translateX(-50%);
  }
  .dock-tip {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    padding: 4px 10px;
    border-radius: 8px;
    background: var(--text);
    color: var(--bg);
    font-size: 12px;
    font-weight: 550;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    box-shadow: var(--shadow-sm);
    transition: opacity 0.18s var(--ease-out), transform 0.18s var(--ease-out);
  }
  .dock-item:hover .dock-tip,
