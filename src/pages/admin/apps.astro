---
import AppIcon from '../../components/AppIcon.astro';
import Base from '../../layouts/Base.astro';
import AdminHeader from '../../components/AdminHeader.astro';
import { getApps } from '../../lib/apps';
import { githubLinks } from '../../lib/github';
const apps = await getApps();
---
<Base lang="zh" title="软件与仓库" standalone>
  <div class="wrap app-admin">
    <AdminHeader title="软件与仓库" description="每款软件的官网、GitHub 仓库与反馈入口。" />
    <p data-hint role="status">正在加载…</p>
    <div class="apps" data-content hidden>
      {apps.map((app) => {
        const links = githubLinks(app.data.repo)!;
        return <article class="card">
          <div class="heading"><AppIcon app={app} size={48} /><div><h2>{app.data.name}</h2><p>{app.id}</p></div></div>
          <a class="repo" href={links.repo} target="_blank" rel="noopener noreferrer">{links.repo.replace('https://github.com/', '')} ↗</a>
          <div class="links"><a href={`/apps/${app.id}/`}>软件主页</a><a href={links.issues} target="_blank" rel="noopener noreferrer">GitHub Issues ↗</a><a href={`/admin/feedback/?app=${app.id}`}>查看反馈</a></div>
        </article>;
      })}
    </div>
  </div>
</Base>
<script>
  import { getMe, onSignedOut } from '../../lib/auth-client';
  const content = document.querySelector<HTMLElement>('[data-content]')!;
  const hint = document.querySelector<HTMLElement>('[data-hint]')!;
  getMe().then((me) => { content.hidden = !me?.adminFeedback; hint.textContent = me?.adminFeedback ? '' : '请登录管理员账号。'; });
  onSignedOut(() => { content.hidden = true; hint.textContent = '已退出登录。'; });
</script>
<style>
  .app-admin { padding-bottom: 80px; }
  .page-hero { padding-bottom: 0; }
  [hidden] { display: none !important; }
  .apps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .card { padding: 24px; min-width: 0; box-shadow: none; }
  .heading { display: flex; align-items: center; gap: 12px; }
  h2 { font-size: 18px; }
  .heading p { font-size: 12px; color: var(--text-3); }
  .repo { display: block; margin: 18px 0; font: 13px var(--mono); color: var(--accent); overflow-wrap: anywhere; }
  .links { display: flex; flex-wrap: wrap; gap: 16px; border-top: 1px solid var(--line); padding-top: 14px; font-size: 13px; color: var(--text-2); }
  a:hover { text-decoration: underline; }
  @media (max-width: 640px) { .apps { grid-template-columns: 1fr; } }
</style>
