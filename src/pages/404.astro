---
import Base from '../layouts/Base.astro';
---
<Base lang="zh" title="404" standalone>
  <div class="wrap center nf">
    <span class="nf-badge">HTTP 404 · Not Found</span>
    <p class="nf-code" aria-hidden="true">404</p>
    <h1>页面走丢了。</h1>
    <p class="lead">Page not found. 你要找的页面不存在，或已经移动到新位置。</p>
    <div class="cta">
      <a class="btn btn-p" href="/">返回首页</a>
      <a class="btn btn-s" href="/en/">English home</a>
    </div>
    <div class="nf-links">
      <a href="/support/">支持中心</a>
      <span aria-hidden="true">·</span>
      <a href="/news/">官方动态</a>
      <span aria-hidden="true">·</span>
      <a href="/en/support/">Support</a>
    </div>
  </div>
</Base>

<style>
  .nf {
    min-height: clamp(420px, 62vh, 640px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 88px 24px 96px;
  }
  .nf-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 13px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-3);
    letter-spacing: 0.04em;
    margin-bottom: 20px;
  }
  .nf-code {
    font-size: clamp(80px, 16vw, 148px);
    font-weight: 750;
    line-height: 0.92;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(180deg, var(--text) 15%, var(--text-3) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    user-select: none;
    margin-bottom: 18px;
  }
  .nf h1 {
    font-size: clamp(28px, 4.5vw, 42px);
    letter-spacing: -0.03em;
    margin: 0 0 12px;
  }
  .nf .lead {
    font-size: clamp(15px, 1.8vw, 18px);
    color: var(--text-2);
    max-width: 480px;
  }
  .nf .cta {
    margin-top: 28px;
  }
  .nf-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
    font-size: 13.5px;
    color: var(--text-3);
  }
  .nf-links a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    .nf {
      padding: 64px 16px 72px;
    }
  }
</style>
