---
import Base from '../layouts/Base.astro';
---
<Base lang="zh" title="404" standalone>
  <div class="wrap center nf">
    <p class="eyebrow">404</p>
    <h1>页面走丢了。</h1>
    <p class="lead">Page not found. 你要找的页面不存在或已移动。</p>
    <div class="cta">
      <a class="btn btn-p" href="/">返回首页</a>
      <a class="btn btn-s" href="/en/">English home</a>
    </div>
  </div>
</Base>

<style>
  .nf { padding: 120px 0 80px; }
  .nf h1 { margin: 16px 0; }
</style>
