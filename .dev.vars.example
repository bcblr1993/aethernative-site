# 本地开发用的 OAuth 密钥：复制为 .dev.vars 后填写（.dev.vars 不会提交）。
# 本地回调地址：http://localhost:8788/api/auth/google/callback、http://localhost:8788/api/auth/github/callback
# GitHub OAuth App 只能填一个回调地址，本地和线上需要各建一个 App。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 推送服务令牌（本地联调 push-service 时才需要）：openssl rand -hex 32
PUSH_SERVICE_TOKEN=
# 用 Apple 登录（iPhone App；本地联调时才需要）
APPLE_TEAM_ID=
APPLE_SIWA_KEY_ID=
# .p8 文件的完整内容（含 BEGIN / END 行），换行写成 \n
APPLE_SIWA_KEY=
# openssl rand -base64 32
APPLE_TOKEN_KEY=
