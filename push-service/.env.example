# 复制为 .env 后填写。.p8 文件放在 secrets/AuthKey.p8（不要提交到仓库）
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_TOPIC=com.aethernative.app

# 与 Cloudflare Pages 的 PUSH_SERVICE_TOKEN 相同（生成方法见 README）
PUSH_SERVICE_TOKEN=

# 以下可选
# SITE_URL=https://aethernative.com
# POLL_INTERVAL_SECONDS=120
# CONCURRENCY=20
